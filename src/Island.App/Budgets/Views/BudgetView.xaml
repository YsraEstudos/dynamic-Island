<UserControl x:Class="Island.App.Budgets.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Island.App.Budgets.Views"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <!-- DataContext = BudgetViewModel (definido por quem usa esta view). -->
    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,16">
                <views:HeroPanel />
                <views:DaysTable Margin="0,16,0,0" />
                <views:BudgetEditor Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
