<UserControl x:Class="Island.App.Budgets.Views.HeroPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Island.App.Budgets.Views"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <Border Style="{StaticResource Budget.Card}">
        <StackPanel>
            <TextBlock Style="{StaticResource Budget.SectionLabel}" Text="Seu orçamento diário" />

            <!-- Texto que faz fade curto ao mudar (ver TextFadeAnimator). -->
            <TextBlock Style="{StaticResource Budget.HeroNumber}"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       views:TextFadeAnimator.FadeText="{Binding HeroText}" />

            <!-- Barra fina: trilho + preenchimento escalado em X (ver ProgressBarAnimator). -->
            <Grid Margin="0,16,0,0" Height="6">
                <Border CornerRadius="3" Background="{StaticResource Budget.SurfaceHiBrush}" />
                <Border CornerRadius="3"
                        Background="{StaticResource Budget.AccentGradient}"
                        HorizontalAlignment="Stretch"
                        RenderTransformOrigin="0,0.5"
                        views:ProgressBarAnimator.Ratio="{Binding ProgressRatio}">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,12"
                        CornerRadius="12"
                        Background="{StaticResource Budget.SurfaceHiBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Budget.SectionLabel}" Text="Pode usar hoje" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Budget.TextBrush}"
                                   Text="{Binding TodayAllowanceText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14,12"
                        CornerRadius="12"
                        Background="{StaticResource Budget.SurfaceHiBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Budget.SectionLabel}" Text="Sobra no fim do dia" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Budget.TextBrush}"
                                   Text="{Binding LeftAfterTodayText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Margin="0,16,0,0"
                       Foreground="{StaticResource Budget.TextMutedBrush}"
                       Text="{Binding RemainingText}"
                       TextTrimming="CharacterEllipsis" />

            <Border Margin="0,12,0,0"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="{StaticResource Budget.SurfaceHiBrush}"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource Budget.BoolToVis}}">
                <TextBlock Foreground="{StaticResource Budget.TextMutedBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
