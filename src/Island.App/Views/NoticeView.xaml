<UserControl x:Class="Island.App.Views.NoticeView"
             x:Name="NoticeRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,0,22,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="GapColumn" Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Optional glyph; collapsed when the notice has none. -->
        <Viewbox x:Name="GlyphBox"
                 Width="22"
                 Height="22"
                 VerticalAlignment="Center"
                 Visibility="Collapsed">
            <Canvas Width="24" Height="24">
                <Path x:Name="GlyphPath"
                      StrokeThickness="1.8"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayedNotice.Title, ElementName=NoticeRoot}"
                       Style="{StaticResource TitleTextStyle}"
                       FontSize="15"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DisplayedNotice.Subtitle, ElementName=NoticeRoot}"
                       Style="{StaticResource ArtistTextStyle}"
                       Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding DisplayedNotice.Subtitle, ElementName=NoticeRoot, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
        </StackPanel>
    </Grid>
</UserControl>
