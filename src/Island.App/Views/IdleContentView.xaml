<UserControl x:Class="Island.App.Views.IdleContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Island.App.Views"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             Opacity="{Binding ContentOpacity}"
             Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}"
             AutomationProperties.Name="{Binding Description}">
    <!-- Static content, no animation: the text changes only when the reading or the schedule changes. -->
    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
        <Path Data="{Binding Glyph}"
              Width="14" Height="14" Stretch="Uniform"
              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              VerticalAlignment="Center" />
        <TextBlock Text="{Binding PrimaryText}"
                   Style="{StaticResource CompactTimerTextStyle}"
                   Margin="6,0,0,0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsWeather, Converter={StaticResource BoolToVisibility}}">
            <Path Data="{x:Static views:IdleIcons.RainDrop}"
                  Width="10" Height="12" Stretch="Uniform"
                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                  StrokeLineJoin="Round" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RainText}"
                       Style="{StaticResource CompactTimerTextStyle}"
                       Margin="3,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
