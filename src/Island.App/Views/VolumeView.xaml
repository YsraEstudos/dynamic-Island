<UserControl x:Class="Island.App.Views.VolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls"
             Width="300"
             Height="48"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
    <Grid Margin="18,0,18,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
                <Path Data="{StaticResource IconSpeakerBody}" Fill="{StaticResource TextPrimaryBrush}" />
                <Path Data="{StaticResource IconSpeakerWaves}"
                      Stroke="{StaticResource TextPrimaryBrush}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <Path Data="{StaticResource IconSpeakerMute}"
                      Stroke="{StaticResource MutedRedBrush}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
            </Canvas>
        </Viewbox>

        <TextBlock Grid.Column="1"
                   Text="Volume"
                   Style="{StaticResource LabelTextStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,14,0" />

        <controls:FractionBar Grid.Column="2"
                              Height="14"
                              BarThickness="6"
                              VerticalAlignment="Center"
                              Value="{Binding VolumeFraction}"
                              TrackBrush="{StaticResource VolumeTrackBrush}">
            <controls:FractionBar.Style>
                <Style TargetType="{x:Type controls:FractionBar}">
                    <Setter Property="FillBrush" Value="{StaticResource AccentGreenBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="FillBrush" Value="{StaticResource MutedRedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:FractionBar.Style>
        </controls:FractionBar>

        <TextBlock Grid.Column="3"
                   Text="{Binding VolumeLevel}"
                   Style="{StaticResource ValueTextStyle}"
                   MinWidth="28"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
