<UserControl x:Class="Island.App.Views.IdleContentVerticalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Opacity="{Binding ContentOpacity}"
             Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}"
             AutomationProperties.Name="{Binding Description}">
    <!-- Docked capsule (36 DIPs wide): one value only, the temperature or the start time. -->
    <StackPanel HorizontalAlignment="Center">
        <Path Data="{Binding Glyph}"
              Width="14" Height="14" Stretch="Uniform"
              Margin="0,0,0,5"
              HorizontalAlignment="Center"
              Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <TextBlock Text="{Binding PrimaryText}"
                   Style="{StaticResource CompactTimerTextStyle}"
                   FontSize="11"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
