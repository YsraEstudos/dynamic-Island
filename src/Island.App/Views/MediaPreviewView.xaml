<UserControl x:Class="Island.App.Views.MediaPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls"
             Width="360"
             Height="68"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
    <Grid Margin="12,0,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Album art: placeholder behind a rounded image brush. -->
        <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
            <Border CornerRadius="10" Background="{StaticResource ArtPlaceholderBrush}">
                <Viewbox Width="20" Height="20"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconNote}"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <Border CornerRadius="10">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Grid.Row="1" Text="{Binding Artist}" Style="{StaticResource ArtistTextStyle}" Margin="0,2,0,0" />
        </Grid>

        <!-- Animates only while this view is visible and the media is playing. -->
        <controls:EqualizerGlyph x:Name="Glyph"
                                 Grid.Column="3"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 BarBrush="{StaticResource WaveBrush}" />
    </Grid>
</UserControl>
