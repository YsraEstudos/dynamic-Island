<UserControl x:Class="Island.App.Views.Widgets.GameNotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="280"
             Height="152"
             AutomationProperties.Name="Widget de notas do jogo">
    <Grid>
        <Border Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,11,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid Width="18" Height="18" Margin="0,0,7,0">
                        <Viewbox x:Name="GlyphBox" Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icon.Widget.GameNotes}"
                                      Stroke="#65B6FF" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Image x:Name="GameIcon" Width="18" Height="18" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock x:Name="GameNameText" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               MaxWidth="112" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <wid:ShelfButton x:Name="PrevButton" Width="20" Height="24" CornerRadius="12"
                                     Background="#2C2C2E" Visibility="Collapsed"
                                     Icon="{StaticResource WidgetIcon.ChevronLeft}"
                                     IconBrush="{StaticResource TextSecondaryBrush}" IconSize="12"
                                     AutomationProperties.Name="Jogo anterior"/>
                    <wid:ShelfButton x:Name="NextButton" Width="20" Height="24" CornerRadius="12"
                                     Margin="3,0,0,0" Background="#2C2C2E" Visibility="Collapsed"
                                     Icon="{StaticResource WidgetIcon.ChevronRight}"
                                     IconBrush="{StaticResource TextSecondaryBrush}" IconSize="12"
                                     AutomationProperties.Name="Próximo jogo"/>
                    <wid:ShelfButton x:Name="PinButton" Width="46" Height="24" CornerRadius="12"
                                     Margin="4,0,0,0" Background="#2C2C2E"
                                     LabelText="Fixar" LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Fixar este jogo"/>
                    <wid:ShelfButton x:Name="CaptureButton" Width="26" Height="24" CornerRadius="12"
                                     Margin="4,0,0,0" Background="#25394D"
                                     Icon="{StaticResource WidgetIcon.Plus}" IconBrush="#65B6FF"
                                     IconSize="12" AutomationProperties.Name="Criar nota para este jogo"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,4" ClipToBounds="True">
                <StackPanel x:Name="NotesList" VerticalAlignment="Top">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ListOffset"/>
                    </StackPanel.RenderTransform>
                </StackPanel>

                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <Border x:Name="FooterPanel" Grid.Row="2" Background="#352327" CornerRadius="6"
                    Padding="7,1" VerticalAlignment="Bottom" Visibility="Collapsed">
                <TextBlock x:Name="FooterText" Foreground="#FFD4D7" FontSize="9.5"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
