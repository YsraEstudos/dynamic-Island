<UserControl x:Class="Island.App.Views.Widgets.TimerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             xmlns:local="clr-namespace:Island.App.Views.Widgets"
             Width="300"
             Height="152"
             AutomationProperties.Name="Widget de temporizador e cronômetro">
    <UserControl.Resources>
        <SolidColorBrush x:Key="OrangeSoftBrush" Color="#33FF9F0A" />
        <StreamGeometry x:Key="Timer.Minus">M5,12 H19</StreamGeometry>
        <StreamGeometry x:Key="Timer.Flag">M6,20.5 V4 M6,4.5 H17.5 L14.5,8.5 L17.5,12.5 H6</StreamGeometry>
    </UserControl.Resources>

    <Grid>
        <Border Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16" />

        <Grid Margin="14,11,14,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:TimerModeSwitch x:Name="ModeSwitch" Grid.Row="0" />

            <Grid Grid.Row="2">
                <!-- Countdown: ring with the time on the left, controls on the right. -->
                <Grid x:Name="CountdownPanel">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="CountdownOffset" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="RingHost" Grid.Column="0" Width="88" Height="88" VerticalAlignment="Center"
                          ToolTip="Roda do mouse: ajusta 10 s">
                        <local:TimerRing x:Name="Ring" />
                        <TextBlock x:Name="CountdownText"
                                   Text="05:00"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <wid:ShelfButton x:Name="MinusButton" Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                             Background="{StaticResource ShelfButtonBrush}"
                                             IconBrush="{StaticResource TextSecondaryBrush}"
                                             Icon="{StaticResource Timer.Minus}" IconSize="14"
                                             ToolTip="Menos 1 min" />
                            <wid:ShelfButton x:Name="PresetButton" Grid.Column="2" Height="30" CornerRadius="15"
                                             Background="{StaticResource ShelfButtonBrush}"
                                             LabelBrush="{StaticResource TextPrimaryBrush}"
                                             ToolTip="Trocar a duração predefinida" />
                            <wid:ShelfButton x:Name="PlusButton" Grid.Column="4" Width="30" Height="30" CornerRadius="15"
                                             Background="{StaticResource ShelfButtonBrush}"
                                             IconBrush="{StaticResource TextSecondaryBrush}"
                                             Icon="{StaticResource WidgetIcon.Plus}" IconSize="14"
                                             ToolTip="Mais 1 min" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <wid:ShelfButton x:Name="CountdownPlayButton" Width="44" Height="44" CornerRadius="22"
                                             Background="{StaticResource OrangeSoftBrush}"
                                             IconBrush="{StaticResource AccentOrangeBrush}"
                                             Icon="{StaticResource IconPlay}" AltIcon="{StaticResource IconPause}"
                                             IsFilled="True" IconSize="20" />
                            <wid:ShelfButton x:Name="CountdownResetButton" Width="34" Height="34" CornerRadius="17" Margin="10,0,0,0"
                                             Background="{StaticResource ShelfButtonBrush}"
                                             IconBrush="{StaticResource TextSecondaryBrush}"
                                             Icon="{StaticResource WidgetIcon.History}" IconSize="16"
                                             ToolTip="Reiniciar" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Stopwatch: time, the two laps in view, then play, lap and reset. -->
                <Grid x:Name="StopwatchPanel" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="StopwatchOffset" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StopwatchText"
                               Grid.Row="0"
                               Text="00:00,00"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <local:TimerLapRows x:Name="Laps" Grid.Row="1" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <wid:ShelfButton x:Name="StopwatchPlayButton" Width="30" Height="30" CornerRadius="15"
                                         Background="{StaticResource OrangeSoftBrush}"
                                         IconBrush="{StaticResource AccentOrangeBrush}"
                                         Icon="{StaticResource IconPlay}" AltIcon="{StaticResource IconPause}"
                                         IsFilled="True" IconSize="14" />
                        <wid:ShelfButton x:Name="LapButton" Width="84" Height="30" CornerRadius="15" Margin="8,0,0,0"
                                         Background="{StaticResource ShelfButtonBrush}"
                                         IconBrush="{StaticResource TextSecondaryBrush}"
                                         LabelBrush="{StaticResource TextSecondaryBrush}"
                                         Icon="{StaticResource Timer.Flag}" IconSize="14"
                                         LabelText="Volta" />
                        <wid:ShelfButton x:Name="StopwatchResetButton" Width="30" Height="30" CornerRadius="15" Margin="8,0,0,0"
                                         Background="{StaticResource ShelfButtonBrush}"
                                         IconBrush="{StaticResource TextSecondaryBrush}"
                                         Icon="{StaticResource WidgetIcon.History}" IconSize="14"
                                         ToolTip="Reiniciar" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
