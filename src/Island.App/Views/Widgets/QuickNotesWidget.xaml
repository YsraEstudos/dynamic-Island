<UserControl x:Class="Island.App.Views.Widgets.QuickNotesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="340"
             Height="152"
             AutomationProperties.Name="Widget de notas rápidas">
    <Grid>
        <Border x:Name="Face" Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,10,14,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: title, count, hotkey warning, open-the-app -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Widget.QuickNotes}"
                                  Stroke="#65B6FF" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Notas" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="11" Margin="7,1,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="HotkeyConflictPanel" Background="#352327" CornerRadius="7" Padding="6,1"
                            Margin="9,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="Ctrl+Alt+N está em uso por outro programa. Use a barra abaixo para capturar uma nota."
                            AutomationProperties.Name="Atalho global Ctrl+Alt+N indisponível">
                        <TextBlock Text="⚠ atalho em uso" Foreground="#FFD4D7" FontSize="9.5"/>
                    </Border>
                </StackPanel>

                <wid:ShelfButton x:Name="OpenButton" HorizontalAlignment="Right" Width="72" Height="24" CornerRadius="12"
                                 Background="#2C2C2E" LabelText="Abrir app"
                                 LabelBrush="{StaticResource TextSecondaryBrush}"
                                 AutomationProperties.Name="Abrir app de notas"/>
            </Grid>

            <!-- Quick capture: opens the small capture window that grows out of this bar -->
            <wid:ShelfButton x:Name="CaptureButton" Grid.Row="1" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                             CornerRadius="11" Background="#202A33"
                             Icon="{StaticResource WidgetIcon.Plus}" IconBrush="#65B6FF" IconSize="12"
                             LabelText="Escrever nota rápida…"
                             LabelBrush="#9DB4C8"
                             AutomationProperties.Name="Criar nota rápida"/>

            <!-- Latest notes: click one to open it in the app -->
            <StackPanel x:Name="NotesList" Grid.Row="2" Margin="0,7,0,0" VerticalAlignment="Top"/>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Nenhuma nota ainda — escreva a primeira acima"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
