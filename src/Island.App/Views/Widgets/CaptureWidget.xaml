<UserControl x:Class="Island.App.Views.Widgets.CaptureWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="280"
             Height="152"
             AutomationProperties.Name="Widget de captura de tela">
    <Grid>
        <Border Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,11,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- Header: icon, title and the recording timer. -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Widget.Capture}"
                                  Stroke="#F5A36B" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Captura" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TimerText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#FF8A80" FontSize="12" FontWeight="SemiBold"
                           Visibility="Collapsed" AutomationProperties.Name="Tempo de gravação"/>
            </Grid>

            <!-- Body: last screenshot on the left, status on the right. -->
            <Grid Grid.Row="1" Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ThumbFrame" Grid.Column="0" Background="#202022" CornerRadius="8"
                        ClipToBounds="True" Cursor="Hand" Opacity="1"
                        RenderTransformOrigin="0.5,0.5"
                        AutomationProperties.Name="Abrir última captura">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                        <TextBlock x:Name="ThumbEmpty" Text="Sem print ainda" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="#FF5A5F"
                                 Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusTitle" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail" Margin="0,4,0,0" FontSize="10.5" TextWrapping="Wrap"
                               MaxHeight="28" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <Border x:Name="ConflictPanel" Background="#352327" CornerRadius="6" Padding="7,2"
                            Margin="0,8,0,0" Visibility="Collapsed"
                            AutomationProperties.Name="Atalhos de captura indisponíveis">
                        <TextBlock x:Name="ConflictText" Foreground="#FFD4D7" FontSize="9.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer: actions. -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <wid:ShelfButton x:Name="PrintButton" Width="78" Height="24" CornerRadius="12"
                                     Background="#2C2C2E" LabelText="Print"
                                     Icon="{StaticResource Icon.Widget.Capture}" IconBrush="#F5A36B"
                                     IconSize="12" LabelBrush="{StaticResource TextPrimaryBrush}"
                                     AutomationProperties.Name="Tirar print da tela"/>
                    <wid:ShelfButton x:Name="RecordButton" Width="84" Height="24" CornerRadius="12"
                                     Margin="6,0,0,0" Background="#3A2A2C" LabelText="Gravar"
                                     Icon="{StaticResource WidgetIcon.Color}" IsFilled="True" IconBrush="#FF5A5F"
                                     IconSize="10" LabelBrush="{StaticResource TextPrimaryBrush}"
                                     AutomationProperties.Name="Iniciar ou parar gravação"/>
                    <wid:ShelfButton x:Name="CopyButton" Width="84" Height="24" CornerRadius="12"
                                     Margin="6,0,0,0" Background="#2C2C2E" LabelText="Copiar"
                                     Icon="{StaticResource WidgetIcon.Copy}" IconBrush="{StaticResource TextSecondaryBrush}"
                                     IconSize="12" LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Copiar o último print"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
