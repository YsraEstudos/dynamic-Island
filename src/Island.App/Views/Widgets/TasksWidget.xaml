<UserControl x:Class="Island.App.Views.Widgets.TasksWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls"
             Width="300"
             Height="152"
             AutomationProperties.Name="Widget de tarefas em andamento">
    <UserControl.Resources>
        <!-- Row bar: 4 DIPs, blue while running, green when done, orange on error. The fill springs to the row's value. -->
        <Style x:Key="TaskRowBarStyle" TargetType="{x:Type controls:FractionBar}">
            <Setter Property="BarThickness" Value="4" />
            <Setter Property="FillBrush" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="TrackBrush" Value="{StaticResource TaskProgressTrackBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="FillBrush" Value="{StaticResource AccentGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="FillBrush" Value="{StaticResource AccentOrangeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,10,14,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: icon and title on the left, the active count on the right. -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Widget.Tasks}"
                                  Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Tarefas" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Rows: up to three tasks, active first. The empty state replaces them when nothing runs. -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <TextBlock Text="Nenhuma tarefa em andamento"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                <ItemsControl ItemsSource="{Binding Tasks}"
                              Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="12"/>
                                </Grid.RowDefinitions>

                                <!-- Title line: state glyph, title (trimmed), percentage. -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource UiIconCheck}"
                                          Stroke="{StaticResource AccentGreenBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"/>
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource NoticeIconTaskError}"
                                          Stroke="{StaticResource AccentOrangeBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                               FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <controls:FractionBar Grid.Row="1" Value="{Binding Fraction}"
                                                      Style="{StaticResource TaskRowBarStyle}"
                                                      VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="{Binding Detail}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
