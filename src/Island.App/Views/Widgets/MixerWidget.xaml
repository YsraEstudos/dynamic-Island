<UserControl x:Class="Island.App.Views.Widgets.MixerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="280"
             Height="152"
             AutomationProperties.Name="Widget de mixer de volume por aplicativo">
    <Grid>
        <Border Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,11,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Widget.Mixer}"
                                  Stroke="#FF9F0A" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Mixer" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="11" Margin="7,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <wid:ShelfButton x:Name="DiscordButton" Width="104" Height="22" CornerRadius="11"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Background="#2C2C2E" LabelText="Mutar Discord"
                                 LabelBrush="{StaticResource TextSecondaryBrush}"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="Mutar ou ligar o Discord"/>
            </Grid>

            <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True" Background="Transparent" Margin="0,4,0,2">
                <Canvas x:Name="RowsPanel" Width="252" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <TextBlock x:Name="EmptyText" Text="Nenhum app com som agora"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource TextTertiaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <wid:ShelfButton x:Name="PrevButton" Width="24" Height="16" CornerRadius="8"
                                     Background="#2C2C2E" LabelText="‹"
                                     LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Apps anteriores"/>
                    <wid:ShelfButton x:Name="NextButton" Width="24" Height="16" CornerRadius="8"
                                     Margin="4,0,0,0" Background="#2C2C2E" LabelText="›"
                                     LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Próximos apps"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
