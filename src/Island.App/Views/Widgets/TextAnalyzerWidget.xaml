<UserControl x:Class="Island.App.Views.Widgets.TextAnalyzerWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             xmlns:local="clr-namespace:Island.App.Views.Widgets"
             Width="320"
             Height="152"
             AllowDrop="True"
             AutomationProperties.Name="Widget analisador de texto">
    <Grid>
        <Border x:Name="Surface" Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,11,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Widget.TextAnalyzer}"
                                  Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Analisador" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <wid:ShelfButton x:Name="PasteButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="50" Height="22" CornerRadius="11" Background="#2C2C2E"
                                 LabelText="Colar" LabelBrush="{StaticResource TextSecondaryBrush}"
                                 AutomationProperties.Name="Analisar o texto copiado"/>
            </Grid>

            <Grid x:Name="ProgressTrack" Grid.Row="1" ClipToBounds="True" Visibility="Collapsed">
                <Border x:Name="ProgressBar" Width="70" Height="2" CornerRadius="1" HorizontalAlignment="Left"
                        Background="{StaticResource AccentBlueBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressOffset"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Grid x:Name="CardsGrid" Grid.Row="2" Margin="0,3,0,3" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <local:TextAnalyzerCard x:Name="CharactersCard" Grid.Row="0" Grid.Column="0" Margin="2,1"
                                        Label="Caracteres"/>
                <local:TextAnalyzerCard x:Name="WordsCard" Grid.Row="0" Grid.Column="1" Margin="2,1"
                                        Label="Palavras"/>
                <local:TextAnalyzerCard x:Name="ParagraphsCard" Grid.Row="0" Grid.Column="2" Margin="2,1"
                                        Label="Parágrafos"/>
                <local:TextAnalyzerCard x:Name="ReadingCard" Grid.Row="1" Grid.Column="0" Margin="2,1"
                                        Label="Leitura"/>
                <local:TextAnalyzerCard x:Name="TokensCard" Grid.Row="1" Grid.Column="1" Margin="2,1"
                                        Label="Tokens"
                                        ToolTip="Estimativa aproximada, não a contagem exata do modelo de IA."/>
                <local:TextAnalyzerCard x:Name="SentencesCard" Grid.Row="1" Grid.Column="2" Margin="2,1"
                                        Label="Frases"/>
            </Grid>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Copie um texto para analisar"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="11.5" TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="Collapsed" IsHitTestVisible="False"/>

            <TextBlock x:Name="PreviewText" Grid.Row="3" FontSize="10.5" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
        </Grid>
    </Grid>
</UserControl>
