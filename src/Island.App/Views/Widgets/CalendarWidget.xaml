<UserControl x:Class="Island.App.Views.Widgets.CalendarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="280"
             Height="152">
    <UserControl.Resources>
        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#332C2C2E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#332C2C2E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="4" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Month and year with previous and next. -->
        <Grid Grid.Row="0">
            <TextBlock x:Name="MonthTitle"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <wid:ShelfButton x:Name="PrevButton" Width="24" Height="24" CornerRadius="12"
                                 Background="#2C2C2E"
                                 Icon="{StaticResource WidgetIcon.ChevronLeft}" IconSize="12"
                                 IconBrush="{StaticResource TextSecondaryBrush}" />
                <wid:ShelfButton x:Name="NextButton" Width="24" Height="24" CornerRadius="12" Margin="6,0,0,0"
                                 Background="#2C2C2E"
                                 Icon="{StaticResource WidgetIcon.ChevronRight}" IconSize="12"
                                 IconBrush="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <UniformGrid x:Name="WeekdayGrid" Grid.Row="2" Columns="7" />
        <UniformGrid x:Name="DayGrid" Grid.Row="3" Columns="7" Rows="6" />
    </Grid>
</UserControl>
