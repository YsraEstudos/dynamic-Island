<UserControl x:Class="Island.App.Views.Widgets.PomodoroWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="300"
             Height="152">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PomodoroOrangeBrush" Color="#FF9F0A" />
        <SolidColorBrush x:Key="PomodoroOrangeSoftBrush" Color="#33FF9F0A" />
        <SolidColorBrush x:Key="PomodoroRedBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="PomodoroRedSoftBrush" Color="#33FF453A" />
        <SolidColorBrush x:Key="PomodoroChipBrush" Color="#2C2C2E" />
    </UserControl.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="6" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Phase pills, then the pomodoro count (xN while stopped, progress N/M while a plan runs). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <wid:ShelfButton x:Name="FocusPill" Width="62" Height="26" CornerRadius="13" />
            <wid:ShelfButton x:Name="BreakPill" Width="62" Height="26" CornerRadius="13" Margin="8,0,0,0" />
            <wid:ShelfButton x:Name="AngryPill" Width="62" Height="26" CornerRadius="13" Margin="8,0,0,0" />
            <wid:ShelfButton x:Name="CyclesPill" Width="56" Height="26" CornerRadius="13" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Minute ruler: drag to change the duration (only while stopped). -->
        <wid:MinuteRuler x:Name="Ruler" Grid.Row="2" Height="50" HorizontalAlignment="Stretch" />

        <!-- Controls and remaining time. -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <wid:ShelfButton x:Name="PlayButton" Width="40" Height="40" CornerRadius="20"
                                 Background="{StaticResource PomodoroOrangeSoftBrush}"
                                 IconBrush="{StaticResource PomodoroOrangeBrush}"
                                 Icon="{StaticResource IconPlay}" AltIcon="{StaticResource IconPause}"
                                 IsFilled="True" IconSize="18" />
                <wid:ShelfButton x:Name="SoundButton" Width="34" Height="34" CornerRadius="17" Margin="10,0,0,0"
                                 Background="{StaticResource PomodoroChipBrush}"
                                 IconBrush="{StaticResource TextSecondaryBrush}"
                                 Icon="{StaticResource IconSpeakerWaves}" AltIcon="{StaticResource IconSpeakerMute}"
                                 IconSize="16" />
                <wid:ShelfButton x:Name="ResetButton" Width="34" Height="34" CornerRadius="17" Margin="8,0,0,0"
                                 Background="{StaticResource PomodoroChipBrush}"
                                 IconBrush="{StaticResource TextSecondaryBrush}"
                                 Icon="{StaticResource WidgetIcon.Stopwatch}" IconSize="16" />
            </StackPanel>

            <TextBlock x:Name="TimeText"
                       Text="25:00"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PomodoroOrangeBrush}"
                       Typography.NumeralAlignment="Tabular" />
        </Grid>
    </Grid>
</UserControl>
