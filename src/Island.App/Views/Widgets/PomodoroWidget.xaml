<UserControl x:Class="Island.App.Views.Widgets.PomodoroWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             Width="300"
             Height="152">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PomodoroOrangeBrush" Color="#FF9F0A" />
        <SolidColorBrush x:Key="PomodoroOrangeSoftBrush" Color="#33FF9F0A" />
        <SolidColorBrush x:Key="PomodoroRedBrush" Color="#FF453A" />
        <SolidColorBrush x:Key="PomodoroRedSoftBrush" Color="#33FF453A" />
        <SolidColorBrush x:Key="PomodoroChipBrush" Color="#2C2C2E" />
        <SolidColorBrush x:Key="PomodoroGreyBrush" Color="#A1A1A6" />
    </UserControl.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="4" />
            <RowDefinition Height="14" />
            <RowDefinition Height="2" />
            <RowDefinition Height="44" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Row 0: phase pills (Pré, Focus, Break, Angry) on the left, the pomodoro stepper on the right. -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <wid:ShelfButton x:Name="PrepPill" Width="44" Height="26" CornerRadius="13" />
                <wid:ShelfButton x:Name="FocusPill" Width="44" Height="26" CornerRadius="13" Margin="4,0,0,0" />
                <wid:ShelfButton x:Name="BreakPill" Width="44" Height="26" CornerRadius="13" Margin="4,0,0,0" />
                <wid:ShelfButton x:Name="AngryPill" Width="44" Height="26" CornerRadius="13" Margin="4,0,0,0" />
            </StackPanel>

            <wid:CycleStepper x:Name="Stepper" Width="76" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Row 2: plan track (one segment per pomodoro) and the forecast of when the plan ends. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <wid:PlanTrack x:Name="Track" Grid.Column="0" Height="4" VerticalAlignment="Center" Margin="0,0,10,0" />

            <TextBlock x:Name="ForecastText"
                       Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextWrapping="NoWrap"
                       Foreground="{StaticResource PomodoroGreyBrush}" />
        </Grid>

        <!-- Row 4: minute ruler, drag to change the duration (only while stopped). -->
        <wid:MinuteRuler x:Name="Ruler" Grid.Row="4" Height="44" HorizontalAlignment="Stretch" />

        <!-- Row 5: controls on the left, remaining time on the right. -->
        <Grid Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <wid:ShelfButton x:Name="PlayButton" Width="38" Height="38" CornerRadius="19"
                                 Background="{StaticResource PomodoroOrangeSoftBrush}"
                                 IconBrush="{StaticResource PomodoroOrangeBrush}"
                                 Icon="{StaticResource IconPlay}" AltIcon="{StaticResource IconPause}"
                                 IsFilled="True" IconSize="18" />
                <wid:ShelfButton x:Name="SoundButton" Width="34" Height="34" CornerRadius="17" Margin="10,0,0,0"
                                 Background="{StaticResource PomodoroChipBrush}"
                                 IconBrush="{StaticResource TextSecondaryBrush}"
                                 Icon="{StaticResource IconSpeakerWaves}" AltIcon="{StaticResource IconSpeakerMute}"
                                 IconSize="16" />
                <wid:ShelfButton x:Name="ResetButton" Width="34" Height="34" CornerRadius="17" Margin="8,0,0,0"
                                 Background="{StaticResource PomodoroChipBrush}"
                                 IconBrush="{StaticResource TextSecondaryBrush}"
                                 Icon="{StaticResource WidgetIcon.Stopwatch}" IconSize="16" />
            </StackPanel>

            <TextBlock x:Name="TimeText"
                       Text="25:00"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PomodoroOrangeBrush}"
                       Typography.NumeralAlignment="Tabular" />
        </Grid>
    </Grid>
</UserControl>
