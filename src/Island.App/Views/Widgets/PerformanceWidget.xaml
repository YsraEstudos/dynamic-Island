<UserControl x:Class="Island.App.Views.Widgets.PerformanceWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wid="clr-namespace:Island.App.Widgets"
             xmlns:views="clr-namespace:Island.App.Views.Widgets"
             Width="300"
             Height="152"
             AutomationProperties.Name="Widget de desempenho">
    <Grid>
        <Border Background="#161616" BorderBrush="#303033" BorderThickness="1" CornerRadius="16"/>

        <Grid Margin="14,10,14,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Widget.Performance}"
                                  Stroke="#30D158" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Desempenho" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <wid:ShelfButton x:Name="AlertToggle" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="62" Height="22" CornerRadius="11" Background="#2C2C2E"
                                 LabelText="Alerta" LabelBrush="{StaticResource TextSecondaryBrush}"
                                 AutomationProperties.Name="Ligar ou desligar o alerta de temperatura"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <views:PerformanceMetricPanel x:Name="CpuPanel" Grid.Column="0"/>
                <views:PerformanceMetricPanel x:Name="GpuPanel" Grid.Column="2"/>
            </Grid>

            <Grid Grid.Row="2">
                <StackPanel x:Name="CpuLimit" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <wid:ShelfButton x:Name="CpuDown" Width="20" Height="20" CornerRadius="10" Background="#2C2C2E"
                                     LabelText="‹" LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Reduzir limite da CPU"/>
                    <TextBlock x:Name="CpuLimitText" Width="46" TextAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <wid:ShelfButton x:Name="CpuUp" Width="20" Height="20" CornerRadius="10" Background="#2C2C2E"
                                     LabelText="›" LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Aumentar limite da CPU"/>
                </StackPanel>

                <StackPanel x:Name="GpuLimit" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="GPU" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <wid:ShelfButton x:Name="GpuDown" Width="20" Height="20" CornerRadius="10" Background="#2C2C2E"
                                     LabelText="‹" LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Reduzir limite da GPU"/>
                    <TextBlock x:Name="GpuLimitText" Width="46" TextAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <wid:ShelfButton x:Name="GpuUp" Width="20" Height="20" CornerRadius="10" Background="#2C2C2E"
                                     LabelText="›" LabelBrush="{StaticResource TextSecondaryBrush}"
                                     AutomationProperties.Name="Aumentar limite da GPU"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
