<UserControl x:Class="Island.App.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls"
             xmlns:views="clr-namespace:Island.App.Views">
    <Grid>
        <!-- Pomodoro countdown: shown only while a pomodoro runs (the capsule is then 150 DIPs wide). -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Visibility="{Binding PomodoroRunning, Converter={StaticResource BoolToVisibility}}">
            <controls:PomodoroGlyph Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Phase="{Binding PomodoroPhase}"
                                    IsAngry="{Binding PomodoroAngry}"
                                    ReduceMotion="{Binding PomodoroReduceMotion}" />
            <TextBlock Text="{Binding PomodoroText}"
                       Style="{StaticResource CompactTimerTextStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Idle content (weather, or the start of a scheduled pomodoro): empty unless the capsule is idle. -->
        <views:IdleContentView DataContext="{Binding Idle}" />

        <!-- Static status glyphs share the right side of the capsule without replacing the equalizer. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    AutomationProperties.Name="Status da ilha">
            <Path Data="{StaticResource UiIconTaskPending}"
                  Width="14" Height="14" Stretch="Uniform"
                  Stroke="{StaticResource AccentGreenBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Há tarefas pendentes"
                  Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolToVisibility}}" />
            <controls:EqualizerGlyph VerticalAlignment="Center"
                                     BarBrush="{StaticResource WaveBrush}"
                                     AutomationProperties.Name="Áudio em reprodução"
                                     Visibility="{Binding IsEqualizerActive, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Task progress percentage, left side. Shown only while a task has a percent and the pomodoro and the idle content
             (which own the left side) are off. -->
        <TextBlock Text="{Binding TaskProgress.PercentText}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CompactTimerTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding TaskProgress.HasPercentText}" Value="True" />
                                <Condition Binding="{Binding PomodoroRunning}" Value="False" />
                                <Condition Binding="{Binding Idle.HasContent}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Task progress bar on the bottom edge, inset to the flat part of the capsule. The layer fades with the task;
             only the indeterminate state pulses. Nothing here animates while no task runs. -->
        <Grid Style="{StaticResource TaskProgressLayerStyle}"
              VerticalAlignment="Bottom"
              Margin="20,0,20,4"
              AutomationProperties.Name="{Binding TaskProgress.Description}">
            <controls:FractionBar Style="{StaticResource TaskProgressFractionStyle}"
                                  Value="{Binding TaskProgress.Fraction}"
                                  VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
