<UserControl x:Class="Island.App.Views.VerticalCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls"
             Width="36"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
    <!-- Capsule height: 124 DIPs, 150 while a pomodoro runs (the countdown needs the room at the top). -->
    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Height" Value="124" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PomodoroRunning}" Value="True">
                    <Setter Property="Height" Value="150" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pomodoro countdown, stacked: animated phase symbol above "MM:SS". 11px tabular digits are about 28 DIPs wide, so they fit in 36. -->
        <StackPanel Grid.Row="0"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Visibility="{Binding PomodoroRunning, Converter={StaticResource BoolToVisibility}}">
            <controls:PomodoroGlyph Width="14"
                                    Height="14"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    Phase="{Binding PomodoroPhase}"
                                    IsAngry="{Binding PomodoroAngry}"
                                    ReduceMotion="{Binding PomodoroReduceMotion}" />
            <TextBlock Text="{Binding PomodoroText}"
                       Style="{StaticResource CompactTimerTextStyle}"
                       FontSize="11"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Static status glyphs stack at the bottom and keep the pomodoro counter at the top. -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13">
            <Path Data="{StaticResource UiIconTaskPending}"
                  Width="14" Height="14" Stretch="Uniform"
                  Stroke="{StaticResource AccentGreenBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Center" Margin="0,0,0,5"
                  AutomationProperties.Name="Há tarefas pendentes"
                  Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolToVisibility}}" />
            <controls:EqualizerGlyph HorizontalAlignment="Center"
                                     BarBrush="{StaticResource WaveBrush}"
                                     AutomationProperties.Name="Áudio em reprodução"
                                     Visibility="{Binding IsEqualizerActive, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
