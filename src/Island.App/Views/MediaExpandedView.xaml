<UserControl x:Class="Island.App.Views.MediaExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls"
             Width="400"
             Height="152">
    <Grid>
        <!-- Shown when there is no media session: a calm placeholder, no controls. -->
        <StackPanel x:Name="Placeholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconNote}"
                          Stroke="{StaticResource TextTertiaryBrush}"
                          StrokeThickness="1.6"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="Nothing playing"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Style="{StaticResource ArtistTextStyle}" />
        </StackPanel>

        <Grid x:Name="MediaContent"
              Margin="22,12,22,12"
              Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="8" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2" />
                <RowDefinition Height="14" />
                <RowDefinition Height="4" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Header: art, title/artist, equalizer. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="52" Height="52">
                    <Border CornerRadius="12" Background="{StaticResource ArtPlaceholderBrush}">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconNote}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Border CornerRadius="12">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" FontSize="15" />
                    <TextBlock Grid.Row="1" Text="{Binding Artist}" Style="{StaticResource ArtistTextStyle}" FontSize="12" Margin="0,3,0,0" />
                </Grid>

                <controls:EqualizerGlyph x:Name="Glyph"
                                         Grid.Column="3"
                                         VerticalAlignment="Top"
                                         Margin="10,4,0,0"
                                         BarBrush="{StaticResource WaveBrush}" />
            </Grid>

            <!-- Progress: drag to seek. -->
            <controls:FractionBar x:Name="SeekBar"
                                  Grid.Row="2"
                                  Height="14"
                                  BarThickness="4"
                                  VerticalAlignment="Center"
                                  Interactive="True"
                                  Value="{Binding Progress}"
                                  FillBrush="{StaticResource TextPrimaryBrush}"
                                  TrackBrush="{StaticResource ProgressTrackBrush}" />

            <Grid Grid.Row="4">
                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
            </Grid>

            <controls:MediaControls Grid.Row="6" />
        </Grid>
    </Grid>
</UserControl>
