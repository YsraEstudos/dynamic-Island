<UserControl x:Class="Island.App.Controls.MediaControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Island.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Decorative (no command yet). -->
        <controls:IconButton Grid.Column="0" Width="30" Height="30"
                             Icon="{StaticResource IconShuffle}" IsOutline="True"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:IconButton Grid.Column="1" Width="30" Height="30"
                             Icon="{StaticResource IconStar}" IsOutline="True"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:IconButton Grid.Column="2" Width="32" Height="32"
                             Icon="{StaticResource IconPrevious}"
                             Command="{Binding PreviousCommand}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:IconButton Grid.Column="3" Width="34" Height="34"
                             Icon="{StaticResource IconPlay}"
                             AltIcon="{StaticResource IconPause}"
                             IsAltShown="{Binding IsPlaying}"
                             Command="{Binding PlayPauseCommand}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:IconButton Grid.Column="4" Width="32" Height="32"
                             Icon="{StaticResource IconNext}"
                             Command="{Binding NextCommand}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Decorative (no command yet). -->
        <controls:IconButton Grid.Column="5" Width="30" Height="30"
                             Icon="{StaticResource IconRepeat}" IsOutline="True"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:IconButton Grid.Column="6" Width="30" Height="30"
                             Icon="{StaticResource IconDevice}" IsOutline="True"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
