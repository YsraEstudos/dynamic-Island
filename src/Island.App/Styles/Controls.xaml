<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Island.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:NullToVisibilityConverter x:Key="NullToVisibility" />

    <!--
        Icon geometry. Every icon is drawn in a 24 x 24 unit box (rendered inside a Canvas of that size).
        Transport icons are filled; utility icons are outlines drawn with a 1.8 unit stroke.
    -->
    <StreamGeometry x:Key="IconPlay">M8.5,5.5 L19,12 L8.5,18.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M7,5 H10.4 V19 H7 Z M13.6,5 H17 V19 H13.6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPrevious">M6,5 H8.4 V19 H6 Z M18.5,5.5 V18.5 L9.5,12 Z</StreamGeometry>
    <StreamGeometry x:Key="IconNext">M5.5,5.5 L14.5,12 L5.5,18.5 Z M15.6,5 H18 V19 H15.6 Z</StreamGeometry>

    <StreamGeometry x:Key="IconShuffle">M3.5,7 H7 C9.8,7 10.6,9.2 11.6,11.4 L12.4,12.6 C13.4,14.8 14.2,17 17,17 H20.5 M3.5,17 H7 C8.6,17 9.5,16.2 10.2,15.1 M17,4.5 L20.5,7 L17,9.5 M17,14.5 L20.5,17 L17,19.5</StreamGeometry>
    <StreamGeometry x:Key="IconStar">M12,4 L14,9.25 L19.6,9.5 L15.2,13.05 L16.7,18.5 L12,15.4 L7.3,18.5 L8.8,13.05 L4.4,9.5 L10,9.25 Z</StreamGeometry>
    <StreamGeometry x:Key="IconRepeat">M6,10.5 V9.5 A3,3 0 0 1 9,6.5 H17 M14.5,4 L17,6.5 L14.5,9 M18,13.5 V14.5 A3,3 0 0 1 15,17.5 H7 M9.5,15 L7,17.5 L9.5,20</StreamGeometry>
    <StreamGeometry x:Key="IconDevice">M8,3.5 H16 A2,2 0 0 1 18,5.5 V18.5 A2,2 0 0 1 16,20.5 H8 A2,2 0 0 1 6,18.5 V5.5 A2,2 0 0 1 8,3.5 Z M9.5,15.5 A2.5,2.5 0 1 0 14.5,15.5 A2.5,2.5 0 1 0 9.5,15.5 Z M11.1,7.5 A0.9,0.9 0 1 0 12.9,7.5 A0.9,0.9 0 1 0 11.1,7.5 Z</StreamGeometry>

    <StreamGeometry x:Key="IconSpeakerBody">M4,9.5 H7.6 L12.2,5.6 V18.4 L7.6,14.5 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSpeakerWaves">M15.2,9 A4,4 0 0 1 15.2,15 M17.6,6.6 A7.6,7.6 0 0 1 17.6,17.4</StreamGeometry>
    <StreamGeometry x:Key="IconSpeakerMute">M16,9.5 L21,14.5 M21,9.5 L16,14.5</StreamGeometry>
    <StreamGeometry x:Key="IconNote">M9,17.5 V6 L19,4 V15.5 M7,17.5 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M17,15.5 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0</StreamGeometry>

    <!-- Icon button: press spring and play/pause crossfade are driven from code (IconButton). -->
    <Style TargetType="{x:Type controls:IconButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:IconButton}">
                    <Grid x:Name="PART_Root" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PART_Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="PART_Icon"
                                      Data="{TemplateBinding Icon}"
                                      Fill="{TemplateBinding Foreground}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="0"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5" />
                                <Path x:Name="PART_Alt"
                                      Data="{TemplateBinding AltIcon}"
                                      Fill="{TemplateBinding Foreground}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="0"
                                      StrokeLineJoin="Round"
                                      RenderTransformOrigin="0.5,0.5"
                                      Opacity="0" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="controls:IconButton.IsOutline" Value="True">
                            <Setter TargetName="PART_Icon" Property="Fill" Value="{x:Null}" />
                            <Setter TargetName="PART_Icon" Property="StrokeThickness" Value="1.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shelf, notice and menu icons (24-unit boxes). Outline style, 1.8 stroke, like the utility icons above. -->
    <StreamGeometry x:Key="UiIconCheck">M5,12.5 L9.8,17 L19,7.5</StreamGeometry>
    <StreamGeometry x:Key="UiIconClose">M7,7 L17,17 M17,7 L7,17</StreamGeometry>
    <StreamGeometry x:Key="UiIconTimer">M12,6.5 A6.5,6.5 0 1 0 12,19.5 A6.5,6.5 0 1 0 12,6.5 Z M12,9.5 V13 L14.5,14.8 M9.5,3.5 H14.5</StreamGeometry>
    <StreamGeometry x:Key="UiIconMenuShelf">M4,5 H10 V11 H4 Z M14,5 H20 V19 H14 Z M4,14 H10 V19 H4 Z</StreamGeometry>
    <StreamGeometry x:Key="UiIconMenuClipboard">M9,5.5 H6.8 A1.3,1.3 0 0 0 5.5,6.8 V19.2 A1.3,1.3 0 0 0 6.8,20.5 H17.2 A1.3,1.3 0 0 0 18.5,19.2 V6.8 A1.3,1.3 0 0 0 17.2,5.5 H15 M9,3.5 H15 V7.5 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="UiIconMenuSettings">M4,7 H20 M4,17 H20 M9,4.5 V9.5 M15,14.5 V19.5</StreamGeometry>
    <StreamGeometry x:Key="UiIconMenuQuit">M12,3.5 V11.5 M7.2,6.6 A7,7 0 1 0 16.8,6.6</StreamGeometry>
</ResourceDictionary>
