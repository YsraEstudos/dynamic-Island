<Window x:Class="Island.App.Shell.CalendarDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agenda do dia"
        Width="500"
        Height="560"
        MinWidth="420"
        MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource MenuBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource IslandFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CalendarActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ShelfButtonBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="AGENDA DO DIA" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="DateTitle" Margin="0,5,0,0" FontSize="22" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="CloseButton" Width="34" Height="34" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Content="×" FontSize="21" Padding="0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Style="{StaticResource CalendarActionButtonStyle}" AutomationProperties.Name="Fechar agenda" />
        </Grid>

        <UniformGrid Grid.Row="1" Margin="0,16,0,0" Columns="3">
            <Button x:Name="AddTaskButton" Margin="0,0,6,0" Content="＋ Tarefa"
                    Style="{StaticResource CalendarActionButtonStyle}"
                    Background="#263B2C" Foreground="{StaticResource AccentGreenBrush}" />
            <Button x:Name="AddEventButton" Margin="3,0" Content="＋ Evento"
                    Style="{StaticResource CalendarActionButtonStyle}"
                    Background="#302A3B" Foreground="#C7A4FF" />
            <Button x:Name="AddBirthdayButton" Margin="6,0,0,0" Content="＋ Aniversário"
                    Style="{StaticResource CalendarActionButtonStyle}"
                    Background="#3A292F" Foreground="#FF9FB2" />
        </UniformGrid>

        <Border Grid.Row="2" Margin="0,10,0,0" Height="1" Background="{StaticResource MenuSeparatorBrush}" />

        <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
            <StackPanel x:Name="DayContent" />
        </ScrollViewer>
    </Grid>
</Window>
