<Window x:Class="Island.App.Shell.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agendar pomodoro"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{StaticResource MenuBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource IslandFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="OnLoaded">

    <Window.Resources>
        <!-- Action buttons share one shape; a disabled button fades out. -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ShelfButtonBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode pills: fully rounded; the colours are set in code for the selected one. -->
        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and the one-line rule. -->
        <TextBlock Grid.Row="0"
                   Text="Agendar pomodoro"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,0"
                   Text="Cada início agendado roda quantos pomodoros couberem entre o começo e o término."
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />

        <!-- Day (today to 30 days ahead) and clock time, HH:mm. An invalid or past value shows the error and disables the confirm button. -->
        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   Text="Quando"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Day stepper: ‹ label › -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="DayBackButton"
                        Width="44"
                        Content="‹"
                        FontSize="18"
                        Padding="0,4"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnDayBackClicked" />
                <TextBlock x:Name="DayText"
                           Width="110"
                           Margin="6,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center" />
                <Button x:Name="DayForwardButton"
                        Width="44"
                        Content="›"
                        FontSize="18"
                        Padding="0,4"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnDayForwardClicked" />
            </StackPanel>

            <Border Grid.Column="2"
                    Padding="12,8"
                    Width="140"
                    HorizontalAlignment="Right"
                    Background="{StaticResource ShelfTileBrush}"
                    BorderBrush="{StaticResource MenuSeparatorBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBox x:Name="TimeBox"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontSize="22"
                         FontWeight="SemiBold"
                         MaxLength="5"
                         SpellCheck.IsEnabled="False"
                         TextChanged="OnFormChanged" />
            </Border>
        </Grid>
        <TextBlock x:Name="TimeError"
                   Grid.Row="4"
                   Margin="0,6,0,0"
                   Text="Use o formato HH:mm, por exemplo 14:30."
                   FontSize="12"
                   Foreground="{StaticResource MutedRedBrush}"
                   Visibility="Collapsed" />

        <!-- Mode: Focus (normal plan) or Angry (locked plan). -->
        <TextBlock Grid.Row="5"
                   Margin="0,14,0,0"
                   Text="Modo"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Grid Grid.Row="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="FocusModeButton"
                    Grid.Column="0"
                    Content="Focus"
                    Style="{StaticResource PillButtonStyle}"
                    Click="OnFocusModeClicked" />
            <Button x:Name="AngryModeButton"
                    Grid.Column="2"
                    Content="Angry"
                    Style="{StaticResource PillButtonStyle}"
                    Click="OnAngryModeClicked" />
        </Grid>

        <!-- End time, then the focus and break lengths in minutes. The number of pomodoros follows from them (see the preview). -->
        <Grid Grid.Row="7" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Termina às" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Foco (min)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="4" Text="Pausa (min)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
        <Grid Grid.Row="8" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="12,8" Background="{StaticResource ShelfTileBrush}"
                    BorderBrush="{StaticResource MenuSeparatorBrush}" BorderThickness="1" CornerRadius="10">
                <TextBox x:Name="EndBox" Padding="0" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontSize="18" FontWeight="SemiBold" MaxLength="5" HorizontalContentAlignment="Center"
                         SpellCheck.IsEnabled="False" AutomationProperties.Name="Horário final"
                         TextChanged="OnFormChanged" />
            </Border>
            <Border Grid.Column="2" Padding="12,8" Background="{StaticResource ShelfTileBrush}"
                    BorderBrush="{StaticResource MenuSeparatorBrush}" BorderThickness="1" CornerRadius="10">
                <TextBox x:Name="FocusBox" Padding="0" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontSize="18" FontWeight="SemiBold" MaxLength="3" HorizontalContentAlignment="Center"
                         SpellCheck.IsEnabled="False" AutomationProperties.Name="Minutos de foco"
                         TextChanged="OnFormChanged" />
            </Border>
            <Border Grid.Column="4" Padding="12,8" Background="{StaticResource ShelfTileBrush}"
                    BorderBrush="{StaticResource MenuSeparatorBrush}" BorderThickness="1" CornerRadius="10">
                <TextBox x:Name="BreakBox" Padding="0" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontSize="18" FontWeight="SemiBold" MaxLength="3" HorizontalContentAlignment="Center"
                         SpellCheck.IsEnabled="False" AutomationProperties.Name="Minutos de pausa"
                         TextChanged="OnFormChanged" />
            </Border>
        </Grid>

        <!-- Preview of the chosen start: day and time. -->
        <TextBlock x:Name="PreviewText"
                   Grid.Row="9"
                   Margin="0,12,0,0"
                   FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <!-- Every scheduled start, oldest first. Scrolls past about five rows. -->
        <TextBlock Grid.Row="10"
                   Margin="0,14,0,0"
                   Text="Agendados"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock x:Name="EmptyText"
                   Grid.Row="11"
                   Margin="0,6,0,0"
                   Text="Nenhum pomodoro agendado"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <ScrollViewer x:Name="StartsScroll"
                      Grid.Row="11"
                      Margin="0,6,0,0"
                      MaxHeight="220"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <ItemsControl x:Name="StartsList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="12,8"
                                Background="{StaticResource ShelfTileBrush}"
                                BorderBrush="{StaticResource MenuSeparatorBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Width="110"
                                           VerticalAlignment="Center"
                                           Text="{Binding Day}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding Time}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Grid.Column="2"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Mode}"
                                           Foreground="{Binding ModeBrush}" />
                                <TextBlock Grid.Column="3"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Count}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <Button Grid.Column="4"
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Content="Editar"
                                        FontSize="12"
                                        ToolTip="Editar faixa"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnEditClicked" />
                                <Button Grid.Column="5"
                                        Width="28"
                                        Height="28"
                                        Margin="6,0,0,0"
                                        Padding="0"
                                        Content="✕"
                                        FontSize="12"
                                        ToolTip="Excluir"
                                        Tag="{Binding Id}"
                                        Foreground="{StaticResource MutedRedBrush}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnDeleteClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Close on the left, add on the right. The form stays open after each add. -->
        <Grid Grid.Row="12" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CloseButton"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Content="Fechar"
                    IsCancel="True"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="OnCloseClicked" />

            <!-- Shown only while a scheduled start is being edited. -->
            <Button x:Name="CancelEditButton"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    Content="Cancelar edição"
                    Visibility="Collapsed"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="OnCancelEditClicked" />

            <Button x:Name="WeeklyButton"
                    Grid.Column="2"
                    Margin="0,0,10,0"
                    Content="Rotina semanal"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="OnWeeklyClicked" />

            <Button x:Name="ConfirmButton"
                    Grid.Column="3"
                    Background="{StaticResource AccentBlueBrush}"
                    Content="Agendar"
                    IsDefault="True"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="OnConfirmClicked" />
        </Grid>
    </Grid>
</Window>
