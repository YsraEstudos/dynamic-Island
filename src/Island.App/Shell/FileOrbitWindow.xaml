<Window x:Class="Island.App.Shell.FileOrbitWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dynamic Island · Arquivos" Width="420" Height="520" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True"
 ShowInTaskbar="False" WindowStartupLocation="Manual" FontFamily="/DynamicIsland;component/Assets/Fonts/#Sora" Foreground="#EEF0FA">
 <Window.Resources>
  <SolidColorBrush x:Key="OrbitAccent" Color="#7C8CFF"/>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="8"/><Setter Property="Margin" Value="4,0,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#414556" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="{DynamicResource OrbitAccent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Height="24"><Border Height="5" CornerRadius="3" Background="#313440" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource OrbitAccent}" Height="5" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#EEF0FA" Stroke="#707C8CFF" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,18,0"/>
     <Border x:Name="ToggleTrack" Grid.Column="1" Width="44" Height="26" CornerRadius="13" Background="#333747"><Ellipse x:Name="ToggleKnob" Width="20" Height="20" Fill="#EEF0FA" HorizontalAlignment="Left" Margin="3"/></Border>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource OrbitAccent}"/><Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleTrack" Property="BorderBrush" Value="White"/><Setter TargetName="ToggleTrack" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9F3ED"/><Setter Property="Background" Value="#191B25"/>
   <Setter Property="BorderBrush" Value="#30323F"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#282C43"/><Setter TargetName="Surface" Property="BorderBrush" Value="#7C8CFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7C8CFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#39416B"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OrbitActionStyle" TargetType="Button">
   <Setter Property="Foreground" Value="#EEF0FA"/><Setter Property="Background" Value="#191B20"/>
   <Setter Property="BorderBrush" Value="#191B20"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid IsHitTestVisible="False">
     <Grid x:Name="ActionVisual" RenderTransformOrigin="0.5,0.5">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
     </Grid>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#191B25"/><Setter Property="Foreground" Value="#F0F5F2"/>
   <Setter Property="CaretBrush" Value="#7C8CFF"/><Setter Property="BorderBrush" Value="#333747"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F0F5F2"/><Setter Property="Background" Value="#191B25"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#303753"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F0F5F2"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#191B25" CornerRadius="9" BorderBrush="#333747" BorderThickness="1" Padding="12,9"><Grid><TextBlock Text="⌄" Foreground="#7C8CFF" HorizontalAlignment="Right"/></Grid></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="12,9,30,9" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#191B25" BorderBrush="#333747" BorderThickness="1" CornerRadius="9" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,4,0,0">
       <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="32" BorderBrush="#303440" BorderThickness="0">
  <Grid x:Name="SheetGrid">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Button x:Name="SheetCloseButton" Grid.RowSpan="3" Panel.ZIndex="20" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" Padding="0" Visibility="Collapsed" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar painel"/>
   <Grid x:Name="Header" Margin="0,0,0,10" Visibility="Collapsed">
    <StackPanel><TextBlock Text="ILHA DE ARQUIVOS" FontSize="10" Foreground="#7C8CFF"/>
     <TextBlock x:Name="Heading" Text="O que vamos fazer?" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,2"/>
     <TextBlock x:Name="BatchLabel" FontSize="12" Foreground="#8A90A8" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left"/>
    </StackPanel>
    <Button x:Name="CloseButton" Visibility="Collapsed" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="11,7" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar"/>
   </Grid>
   <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="OrbitPanel">
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="HintPill" Background="#0D0E14" BorderBrush="#607C8CFF" BorderThickness="1" CornerRadius="26" Height="46" MinWidth="210" MaxWidth="310" Padding="22,0" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
     <TextBlock x:Name="HintText" Text="↓   Escolha uma ação" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    </Border>
    <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas x:Name="OrbitCanvas" Width="520" Height="560">
     <Ellipse x:Name="OrbitDecoration" Width="512" Height="512" Canvas.Left="4" Canvas.Top="4" Stroke="#26FFFFFF" StrokeThickness="2" StrokeDashArray="1 5" StrokeDashCap="Round" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"/>
     <Grid x:Name="Hub" Width="168" Height="168" Canvas.Left="176" Canvas.Top="176" Panel.ZIndex="4" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Ellipse Fill="#191B20"/>
      <Ellipse x:Name="HubRing" Stroke="#5B8CFF" StrokeThickness="2" Opacity="0.85"/>
      <StackPanel VerticalAlignment="Center" Margin="12,0">
       <TextBlock x:Name="HubTitle" Text="Escolha" FontSize="19" FontWeight="Bold" TextAlignment="Center" Foreground="#EEF0FA" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="HubDetail" Text="arraste até uma ação" FontSize="11.5" Foreground="#8A90A8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
      </StackPanel>
     </Grid>
     <Canvas x:Name="FeedbackCanvas" Width="520" Height="520" Panel.ZIndex="10" IsHitTestVisible="False"/>
     <TextBlock x:Name="CenterCount" Visibility="Collapsed" TextAlignment="Center" FontSize="12" Foreground="#F0F5F2" IsHitTestVisible="False">
      <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="1"/></TextBlock.Effect>
     </TextBlock>
     <Button x:Name="OrbitTrayButton" Content="＋  Bandeja" Canvas.Left="192" Canvas.Top="526" Width="100" Height="28" Padding="8,4" FontSize="11" ToolTip="Guardar arquivos na bandeja"/>
     <Button x:Name="OrbitCloseButton" Content="✕" Canvas.Left="300" Canvas.Top="526" Width="28" Height="28" Padding="0" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar menu radial"/>
    </Canvas></Viewbox>
   </Grid>
   <ScrollViewer x:Name="ActionListPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel><Button x:Name="RadialBackButton" Content="‹  Voltar ao radial" HorizontalAlignment="Left" Margin="0,0,0,18" Padding="10,6"/>
     <UniformGrid x:Name="ActionTiles" Columns="3"/>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer Grid.Row="1" x:Name="OptionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,6">
    <StackPanel>
     <Button x:Name="BackButton" Content="‹  Todas as ações" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,38,0"><Border x:Name="ActionChip" Width="44" Height="44" CornerRadius="14" Margin="0,0,12,0"><Path x:Name="ActionIcon" Width="22" Height="22" Stretch="Uniform" Stroke="#0B0C10" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border><TextBlock x:Name="ActionTitle" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
     <TextBlock x:Name="ActionHelp" TextWrapping="Wrap" Foreground="#8A90A8" FontSize="12" Margin="0,6,0,16"/>
     <StackPanel x:Name="NameOptions" Visibility="Collapsed">
      <TextBlock x:Name="NameLabel" Text="Nome do pacote" Margin="0,0,0,6"/><TextBox x:Name="NameInput"/>
      <TextBlock x:Name="RenameHelp" Visibility="Collapsed" Text="{}{name} nome · {date} data do arquivo · {n:000} sequência · {content} primeira linha de texto (ou nome original)" TextWrapping="Wrap" FontSize="11" Foreground="#8A90A8" Margin="0,6,0,0"/>
     </StackPanel>
     <StackPanel x:Name="FormatOptions" Visibility="Collapsed">
      <TextBlock Text="Formato de saída" Margin="0,0,0,8"/><ComboBox x:Name="FormatInput" Visibility="Collapsed"/><UniformGrid x:Name="FormatSegments" Rows="1"/>
     </StackPanel>
     <Grid x:Name="MediaOptions" Visibility="Collapsed" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ImageWidthColumn"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel x:Name="WidthField" Margin="0,0,16,0"><TextBlock Text="Largura máxima (px)" Margin="0,0,0,6"/><TextBox x:Name="WidthInput" Text="1920"/><Slider x:Name="WidthSlider" Minimum="16" Maximum="8192" TickFrequency="16" IsSnapToTickEnabled="True" Value="1920" Margin="0,10,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Qualidade (10–100)" Margin="0,0,0,6"/><TextBox x:Name="QualityInput" Text="80"/><Slider x:Name="QualitySlider" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="80" Margin="0,10,0,0"/></StackPanel>
     </Grid>
     <Grid x:Name="TrimOptions" Visibility="Collapsed" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Início (segundos)" Margin="0,0,0,6"/><TextBox x:Name="StartInput" Text="0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Duração (0 = até o fim)" Margin="0,0,0,6"/><TextBox x:Name="DurationInput" Text="0"/></StackPanel>
     </Grid>
     <CheckBox x:Name="SimilarInput" Content="Incluir imagens visualmente parecidas" IsChecked="True" Foreground="#EEF0FA" Margin="0,12,0,0" Visibility="Collapsed"/>
     <Border Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,18,0,0"><StackPanel><TextBlock Text="PRÉVIA DO LOTE" Foreground="#7C8CFF" FontSize="10" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="12" Background="#252838" VerticalAlignment="Top" ClipToBounds="True"><Grid><TextBlock x:Name="PreviewFallback" Text="▧" FontSize="25" Foreground="#8A90A8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="PreviewImage" Stretch="UniformToFill"/></Grid></Border>
      <StackPanel Grid.Column="1"><TextBlock x:Name="InputPreview" FontSize="12" Foreground="#C4C8DA" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="BatchMetadata" Foreground="#8A90A8" FontSize="10" Margin="0,7,0,0"/></StackPanel>
     </Grid></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <StackPanel x:Name="ResultPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,20">
    <Grid Width="78" Height="78" HorizontalAlignment="Left" Margin="0,0,0,18"><Ellipse Stroke="#25FFFFFF" StrokeThickness="4"/>
     <Path x:Name="ProgressArc" Data="M39,3 A36,36 0 1 1 3,39" Stroke="{DynamicResource OrbitAccent}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"/>
     <TextBlock x:Name="ResultSymbol" Text="…" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
    <TextBlock x:Name="ResultTitle" Text="Processando…" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="ResultDetail" FontSize="12" Foreground="#8A90A8" TextWrapping="Wrap" Margin="0,10,0,18"/>
    <Button x:Name="AnotherActionButton" Content="Fazer outra ação" HorizontalAlignment="Left"/>
   </StackPanel>
   <StackPanel Grid.Row="2" x:Name="FooterPanel" Visibility="Collapsed">
    <Border Height="1" Background="#25FFFFFF" Margin="0,6,0,14"/>
    <Grid x:Name="DestinationPanel" Visibility="Collapsed" Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="SALVAR EM UMA PASTA NOVA" FontSize="10" Foreground="#7C8CFF"/>
      <TextBlock x:Name="DestinationLabel" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#8A90A8" Margin="0,5,12,0"/></StackPanel>
     <Button x:Name="DestinationButton" Grid.Column="1" Content="Escolher…" Padding="12,6"/>
    </Grid>
    <ProgressBar x:Name="WorkProgress" Height="3" IsIndeterminate="True" Foreground="#7C8CFF" Background="#252838" Visibility="Collapsed" Margin="0,0,0,10"/>
    <TextBlock x:Name="StatusLabel" Text="Os originais ficam intactos. Você escolhe onde salvar." TextWrapping="Wrap" Foreground="#8A90A8" FontSize="11" Margin="0,0,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="TrayButton" Content="＋  Guardar na bandeja" HorizontalAlignment="Left"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="CancelButton" Content="Cancelar" Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="OpenButton" Content="Abrir resultados ↗" Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="RunButton" Content="Executar  →" Visibility="Collapsed" Background="{DynamicResource OrbitAccent}" Foreground="#0B0C10" FontWeight="SemiBold"/>
      <Button x:Name="DoneButton" Content="Concluir" Visibility="Collapsed" Background="{DynamicResource OrbitAccent}" Foreground="#0B0C10" FontWeight="SemiBold"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
