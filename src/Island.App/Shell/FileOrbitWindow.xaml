<Window x:Class="Island.App.Shell.FileOrbitWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dynamic Island · Arquivos" Width="420" Height="460" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True"
 ShowInTaskbar="False" WindowStartupLocation="Manual" FontFamily="/DynamicIsland;component/Assets/Fonts/#Sora" Foreground="#EEF0FA">
 <Window.Resources>
  <SolidColorBrush x:Key="OrbitAccent" Color="#A6F4C5"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E9F3ED"/><Setter Property="Background" Value="#202923"/>
   <Setter Property="BorderBrush" Value="#35483C"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
     BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#314B3B"/><Setter TargetName="Surface" Property="BorderBrush" Value="#A6F4C5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6F4C5"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#45664F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="OrbitActionStyle" TargetType="Button">
   <Setter Property="Foreground" Value="#EEF0FA"/><Setter Property="Background" Value="#191B20"/>
   <Setter Property="BorderBrush" Value="#191B20"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid IsHitTestVisible="False">
     <Grid x:Name="ActionVisual" RenderTransformOrigin="0.5,0.5">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
     </Grid>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#1D2721"/><Setter Property="Foreground" Value="#F0F5F2"/>
   <Setter Property="CaretBrush" Value="#A6F4C5"/><Setter Property="BorderBrush" Value="#405346"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F0F5F2"/><Setter Property="Background" Value="#1D2721"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#34553F"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F0F5F2"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#1D2721" CornerRadius="9" BorderBrush="#405346" BorderThickness="1" Padding="12,9"><Grid><TextBlock Text="⌄" Foreground="#A6F4C5" HorizontalAlignment="Right"/></Grid></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="12,9,30,9" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#1D2721" BorderBrush="#405346" BorderThickness="1" CornerRadius="9" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,4,0,0">
       <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="32" BorderBrush="#3B5042" BorderThickness="0">
  <Grid x:Name="SheetGrid">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="Header" Margin="0,0,0,10" Visibility="Collapsed">
    <StackPanel><TextBlock Text="DYNAMIC ISLAND  /  ARQUIVOS" FontSize="10" Foreground="#A6F4C5"/>
     <TextBlock x:Name="Heading" Text="O que vamos fazer?" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,2"/>
     <TextBlock x:Name="BatchLabel" FontSize="12" Foreground="#A4B7AA" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left"/>
    </StackPanel>
    <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="11,7" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar"/>
   </Grid>
   <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="OrbitPanel">
    <Viewbox Stretch="Uniform"><Canvas x:Name="OrbitCanvas" Width="520" Height="560">
     <Ellipse x:Name="OrbitDecoration" Width="512" Height="512" Canvas.Left="4" Canvas.Top="4" Stroke="#26FFFFFF" StrokeThickness="2" StrokeDashArray="1 5" StrokeDashCap="Round" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"/>
     <Grid x:Name="Hub" Width="168" Height="168" Canvas.Left="176" Canvas.Top="176" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
      <Ellipse Fill="#191B20"/>
      <Ellipse x:Name="HubRing" Stroke="#5B8CFF" StrokeThickness="2" Opacity="0.85"/>
      <StackPanel VerticalAlignment="Center" Margin="12,0">
       <TextBlock x:Name="HubTitle" Text="Escolha" FontSize="19" FontWeight="Bold" TextAlignment="Center" Foreground="#EEF0FA" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="HubDetail" Text="arraste até uma ação" FontSize="11.5" Foreground="#8A90A8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
      </StackPanel>
     </Grid>
     <Canvas x:Name="FeedbackCanvas" Width="520" Height="520" Panel.ZIndex="10" IsHitTestVisible="False"/>
     <TextBlock x:Name="CenterCount" Visibility="Collapsed" TextAlignment="Center" FontSize="12" Foreground="#F0F5F2" IsHitTestVisible="False">
      <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="1"/></TextBlock.Effect>
     </TextBlock>
     <Button x:Name="OrbitTrayButton" Content="＋  Bandeja" Canvas.Left="192" Canvas.Top="526" Width="100" Height="28" Padding="8,4" FontSize="11" ToolTip="Guardar arquivos na bandeja"/>
     <Button x:Name="OrbitCloseButton" Content="✕" Canvas.Left="300" Canvas.Top="526" Width="28" Height="28" Padding="0" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar menu radial"/>
    </Canvas></Viewbox>
   </Grid>
   <ScrollViewer Grid.Row="1" x:Name="OptionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,6">
    <StackPanel>
     <Button x:Name="BackButton" Content="‹  Todas as ações" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,16"/>
     <TextBlock x:Name="ActionTitle" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock x:Name="ActionHelp" TextWrapping="Wrap" Foreground="#A4B7AA" FontSize="12" Margin="0,6,0,16"/>
     <StackPanel x:Name="NameOptions" Visibility="Collapsed">
      <TextBlock x:Name="NameLabel" Text="Nome do pacote" Margin="0,0,0,6"/><TextBox x:Name="NameInput"/>
      <TextBlock x:Name="RenameHelp" Visibility="Collapsed" Text="{}{name} nome · {date} data do arquivo · {n:000} sequência · {content} primeira linha de texto (ou nome original)" TextWrapping="Wrap" FontSize="11" Foreground="#A4B7AA" Margin="0,6,0,0"/>
     </StackPanel>
     <StackPanel x:Name="FormatOptions" Visibility="Collapsed">
      <TextBlock Text="Formato de saída" Margin="0,0,0,6"/><ComboBox x:Name="FormatInput"/>
     </StackPanel>
     <Grid x:Name="MediaOptions" Visibility="Collapsed" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ImageWidthColumn"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel x:Name="WidthField" Margin="0,0,12,0"><TextBlock Text="Largura máxima (px)" Margin="0,0,0,6"/><TextBox x:Name="WidthInput" Text="1920"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Qualidade (10–100)" Margin="0,0,0,6"/><TextBox x:Name="QualityInput" Text="80"/></StackPanel>
     </Grid>
     <Grid x:Name="TrimOptions" Visibility="Collapsed" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Início (segundos)" Margin="0,0,0,6"/><TextBox x:Name="StartInput" Text="0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Duração (0 = até o fim)" Margin="0,0,0,6"/><TextBox x:Name="DurationInput" Text="0"/></StackPanel>
     </Grid>
     <CheckBox x:Name="SimilarInput" Content="Incluir imagens visualmente parecidas" IsChecked="True" Foreground="#DCECE1" Margin="0,12,0,0" Visibility="Collapsed"/>
     <TextBlock Text="PRÉVIA DO LOTE" Foreground="#A6F4C5" FontSize="10" Margin="0,20,0,8"/>
     <TextBlock x:Name="InputPreview" FontSize="12" Foreground="#C8D6CD" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2" x:Name="FooterPanel" Visibility="Collapsed">
    <Border Height="1" Background="#304036" Margin="0,6,0,14"/>
    <Grid x:Name="DestinationPanel" Visibility="Collapsed" Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="SALVAR EM UMA PASTA NOVA" FontSize="10" Foreground="#A6F4C5"/>
      <TextBlock x:Name="DestinationLabel" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#A4B7AA" Margin="0,5,12,0"/></StackPanel>
     <Button x:Name="DestinationButton" Grid.Column="1" Content="Escolher…" Padding="12,6"/>
    </Grid>
    <ProgressBar x:Name="WorkProgress" Height="3" IsIndeterminate="True" Foreground="#A6F4C5" Background="#263A2D" Visibility="Collapsed" Margin="0,0,0,10"/>
    <TextBlock x:Name="StatusLabel" Text="Os originais ficam intactos. Você escolhe onde salvar." TextWrapping="Wrap" Foreground="#A4B7AA" FontSize="11" Margin="0,0,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="TrayButton" Content="＋  Guardar na bandeja" HorizontalAlignment="Left"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="CancelButton" Content="Cancelar" Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="OpenButton" Content="Abrir resultados ↗" Visibility="Collapsed" Margin="0,0,8,0"/>
      <Button x:Name="RunButton" Content="Executar  →" Visibility="Collapsed" Background="#A6F4C5" Foreground="#102218" FontWeight="SemiBold"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
