<Window x:Class="Island.App.Shell.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota rápida"
        Width="420" Height="226"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#8E8E93"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#65B6FF"/>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A1A1A6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C2C2E"/>
                                <Setter Property="Foreground" Value="#F5F5F7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#0B1B2B"/>
            <Setter Property="Background" Value="#65B6FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0B1B2B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Border x:Name="Shadow" Background="#161616" CornerRadius="18" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Card" BorderBrush="#303033" BorderThickness="1" CornerRadius="18">
            <Grid x:Name="Content" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✎" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="Nota rápida" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5F5F7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PinButton" Style="{StaticResource GhostButton}" Padding="8,3"
                                Click="OnPinClick" ToolTip="Fixar no topo"
                                AutomationProperties.Name="Fixar nota">
                            <TextBlock x:Name="PinGlyph" Text="☆" FontSize="14"/>
                        </Button>
                        <Button x:Name="OpenAppButton" Style="{StaticResource GhostButton}" Padding="8,3"
                                Click="OnOpenInAppClick" ToolTip="Continuar no app (Ctrl+Enter)"
                                AutomationProperties.Name="Continuar no app de notas">
                            <TextBlock Text="⤢" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="9,3"
                                Click="OnCloseClick" ToolTip="Fechar (Esc)"
                                AutomationProperties.Name="Fechar captura">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <TextBox x:Name="NoteBox" Background="Transparent" BorderThickness="0"
                             Foreground="#F5F5F7" CaretBrush="#65B6FF" FontSize="14"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                             VerticalScrollBarVisibility="Auto" Padding="0,2"
                             SelectionBrush="#5572B8E8"
                             PreviewKeyDown="OnNoteKeyDown"
                             AutomationProperties.Name="Texto da nota rápida"/>
                    <TextBlock x:Name="Placeholder" Text="Escreva uma ideia, lembrete ou link…"
                               Foreground="#6E6E73" FontSize="14" IsHitTestVisible="False"
                               Margin="2,2,0,0" VerticalAlignment="Top"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ColorDots" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,8,0" FontSize="11"
                               Foreground="#6E6E73" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="Enter salva  ·  Ctrl+Enter abre no app"/>
                    <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource SaveButton}"
                            Content="Salvar" Click="OnSaveClick"
                            AutomationProperties.Name="Salvar nota rápida"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
