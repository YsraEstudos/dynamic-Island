<Window x:Class="Island.App.Shell.QuickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:notes="clr-namespace:Island.Core.Notes;assembly=Island.Core"
        xmlns:appnotes="clr-namespace:Island.App.Notes"
        xmlns:vm="clr-namespace:Island.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Dynamic Island — Notas"
        Width="1072"
        Height="732"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="Transparent"
        Foreground="#F4F6FA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="NotesSurfaceBrush" Color="#171B23"/>
        <SolidColorBrush x:Key="NotesRaisedBrush" Color="#202630"/>
        <SolidColorBrush x:Key="NotesBorderBrush" Color="#2A3240"/>
        <SolidColorBrush x:Key="NotesTextBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="NotesMutedBrush" Color="#929CAA"/>
        <SolidColorBrush x:Key="NotesFaintBrush" Color="#5F6978"/>
        <SolidColorBrush x:Key="NotesAccentBrush" Color="#65B6FF"/>
        <SolidColorBrush x:Key="NotesErrorBrush" Color="#FF8B8B"/>
        <SolidColorBrush x:Key="NotesGoldBrush" Color="#F5C451"/>

        <appnotes:QuickNoteDisplayConverter x:Key="NoteDisplay"/>
        <appnotes:QuickNoteColorBrushConverter x:Key="NoteColorBrush"/>
        <appnotes:QuickNoteColorNameConverter x:Key="NoteColorName"/>

        <!-- Slim dark scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbChrome" Background="#3A4455" CornerRadius="3" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbChrome" Property="Background" Value="#566176"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NotesTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource NotesRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NotesBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource NotesAccentBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#293442"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource NotesAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesPrimaryButton" TargetType="Button" BasedOn="{StaticResource NotesButton}">
            <Setter Property="Background" Value="#2B73B0"/>
            <Setter Property="BorderBrush" Value="#4C9BD8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="NotesGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NotesMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#262E3A"/>
                                <Setter Property="Foreground" Value="{StaticResource NotesTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#262E3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource NotesGhostButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented collection tab. Tag carries "is this the active view". -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource NotesMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="9" Padding="6,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#202833"/>
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Chrome" Property="Background" Value="#25394D"/>
                                <Setter Property="Foreground" Value="{StaticResource NotesTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NotesRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NotesTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NotesBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource NotesAccentBrush}"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="SelectionBrush" Value="#5572B8E8"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource NotesAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless text box used for the title and body: it must look like a page, not a form field. -->
        <Style x:Key="PageTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource NotesTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource NotesAccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#5572B8E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="ChecklistTextBox" TargetType="TextBox" BasedOn="{StaticResource PageTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource NotesTextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="11" Padding="10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#1E2530"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#22364A"/>
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#3C6585"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource NotesAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colour swatch: a dot with a ring when selected. -->
        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" Width="26" Height="26" CornerRadius="13" BorderThickness="2"
                                BorderBrush="Transparent" Background="Transparent"
                                ToolTip="{Binding Converter={StaticResource NoteColorName}}">
                            <Ellipse Width="16" Height="16" Fill="{Binding Converter={StaticResource NoteColorBrush}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#566176"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChecklistCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                                BorderBrush="#566176" Background="Transparent">
                            <Path x:Name="Tick" Data="M4,10 L8,14 L16,5" Stroke="#0B1B2B" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Stretch="None"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NotesAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource NotesAccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource NotesAccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NotesFaintBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="Shadow" Background="#101318" CornerRadius="20" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Card" BorderBrush="#2A3240" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
            <Grid x:Name="Surface">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar: drag area, new note, window buttons -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Height="62"
                      MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Border Width="34" Height="34" CornerRadius="11" Background="#172A3B" Margin="0,0,12,0">
                            <TextBlock Text="✎" FontSize="17" Foreground="{StaticResource NotesAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Notas" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Tudo fica salvo neste dispositivo" FontSize="11"
                                       Foreground="{StaticResource NotesMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="HotkeyConflictBanner" Grid.Column="1" Background="#3B2528"
                            BorderBrush="#704148" BorderThickness="1" CornerRadius="9"
                            Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Atalho global de notas indisponível">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="!" Foreground="{StaticResource NotesErrorBrush}"
                                       FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Ctrl+Alt+N indisponível" Foreground="#FFD4D7" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource NotesPrimaryButton}"
                            Click="OnBeginNewNoteClick" Margin="0,0,14,0" VerticalAlignment="Center"
                            ToolTip="Nova nota (Ctrl+N)"
                            AutomationProperties.Name="Criar nota">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="15" Margin="0,-2,7,0"/>
                            <TextBlock Text="Nova nota"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource NotesGhostButton}" Click="OnMinimizeClick"
                                ToolTip="Minimizar" AutomationProperties.Name="Minimizar">
                            <TextBlock Text="—" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="OnCloseClick"
                                ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar notas">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar: collections, search, list -->
                    <Border Grid.Column="0" Background="{StaticResource NotesSurfaceBrush}"
                            BorderBrush="{StaticResource NotesBorderBrush}" BorderThickness="1" CornerRadius="16"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource NotesTextBox}" Padding="34,8,10,8"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Buscar notas"
                                         ToolTip="Buscar por título, conteúdo ou etiqueta (Ctrl+F)"/>
                                <TextBlock Text="⌕" FontSize="17" Foreground="{StaticResource NotesFaintBrush}"
                                           Margin="12,0,0,2" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="Buscar notas…" Foreground="{StaticResource NotesFaintBrush}"
                                           Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource NavTab}"
                                        Command="{Binding SelectCollectionCommand}"
                                        CommandParameter="{x:Static notes:QuickNoteCollection.Active}"
                                        Tag="{Binding IsActiveView}"
                                        AutomationProperties.Name="Mostrar notas ativas">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Notas"/>
                                        <TextBlock Text="{Binding ActiveCount}" Margin="6,1,0,0" FontSize="10.5" Opacity="0.7"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource NavTab}"
                                        Command="{Binding SelectCollectionCommand}"
                                        CommandParameter="{x:Static notes:QuickNoteCollection.Archived}"
                                        Tag="{Binding IsArchivedView}"
                                        AutomationProperties.Name="Mostrar notas arquivadas">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Arquivo"/>
                                        <TextBlock Text="{Binding ArchivedCount}" Margin="6,1,0,0" FontSize="10.5" Opacity="0.7"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource NavTab}"
                                        Command="{Binding SelectCollectionCommand}"
                                        CommandParameter="{x:Static notes:QuickNoteCollection.Trash}"
                                        Tag="{Binding IsTrashView}"
                                        AutomationProperties.Name="Mostrar notas na lixeira">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Lixeira"/>
                                        <TextBlock Text="{Binding TrashCount}" Margin="6,1,0,0" FontSize="10.5" Opacity="0.7"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="2" Margin="4,0,2,6">
                                <TextBlock Text="{Binding CollectionTitle}" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource NotesGhostButton}"
                                        Padding="8,3" Content="Esvaziar lixeira" FontSize="11"
                                        Click="OnEmptyTrashClick"
                                        Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Esvaziar lixeira"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <ListBox x:Name="NotesList" ItemsSource="{Binding Notes}"
                                         SelectedValuePath="Id" SelectedValue="{Binding SelectedNoteId, Mode=OneWay}"
                                         SelectionChanged="OnNotesSelectionChanged"
                                         PreviewKeyDown="OnNotesListKeyDown"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource NotesListItem}"
                                         AutomationProperties.Name="Lista de notas">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ScrollViewer Focusable="False" Padding="0"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <Border x:Name="DraftRow" Background="#1B2B3B" BorderBrush="#3C6585"
                                                            BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,5"
                                                            Visibility="{Binding IsUnsavedDraft, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✎" Foreground="{StaticResource NotesAccentBrush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Nova nota…" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ItemsPresenter/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="3" CornerRadius="2" Margin="0,2,10,2"
                                                        Background="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=Accent}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=Title}"
                                                               FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=Preview}"
                                                               Visibility="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=HasPreview}"
                                                               Foreground="{StaticResource NotesMutedBrush}" FontSize="11.5"
                                                               Margin="0,3,0,0" MaxHeight="32"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=Tags}"
                                                               Visibility="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=HasTags}"
                                                               Foreground="{StaticResource NotesAccentBrush}" FontSize="10.5"
                                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=Checklist}"
                                                               Visibility="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=HasChecklist}"
                                                               Foreground="{StaticResource NotesFaintBrush}" FontSize="10.5"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="★" Foreground="{StaticResource NotesGoldBrush}"
                                                               FontSize="12" HorizontalAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Converter={StaticResource NoteDisplay}, ConverterParameter=Time}"
                                                               Foreground="{StaticResource NotesFaintBrush}" FontSize="10"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{Binding EmptyListText}" Foreground="{StaticResource NotesFaintBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="14,40,14,0"
                                           VerticalAlignment="Top" IsHitTestVisible="False"
                                           Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Editor -->
                    <Border Grid.Column="2" Background="{StaticResource NotesSurfaceBrush}"
                            BorderBrush="{StaticResource NotesBorderBrush}" BorderThickness="1" CornerRadius="16">
                        <Grid>
                            <Border x:Name="EmptyState"
                                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                                    <Border Width="64" Height="64" CornerRadius="20" Background="#172A3B"
                                            HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="✦" FontSize="28" Foreground="{StaticResource NotesAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Um espaço para suas ideias" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Escolha uma nota na lista ou comece uma nova. Tudo é salvo sozinho enquanto você escreve."
                                               Foreground="{StaticResource NotesMutedBrush}" TextAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,8,0,20"/>
                                    <Button Style="{StaticResource NotesPrimaryButton}" Content="＋  Criar nota"
                                            Click="OnBeginNewNoteClick" HorizontalAlignment="Center" Padding="20,9"
                                            AutomationProperties.Name="Criar primeira nota"/>
                                    <TextBlock Text="Ctrl+N nova nota   ·   Ctrl+F buscar   ·   Esc fechar"
                                               Foreground="{StaticResource NotesFaintBrush}" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="EditorPanel" Margin="26,18,26,16"
                                  Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="EditorTranslation" Y="0"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding AvailableColors}"
                                             SelectedItem="{Binding ColorDraft, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditorEnabled}"
                                             ItemContainerStyle="{StaticResource SwatchItem}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             VerticalAlignment="Center" HorizontalAlignment="Left"
                                             AutomationProperties.Name="Cor da nota">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ItemsPresenter/>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate><Grid/></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource NotesButton}" Padding="12,6" Margin="0,0,6,0"
                                                Command="{Binding TogglePinCommand}"
                                                IsEnabled="{Binding IsEditorEnabled}"
                                                ToolTip="Fixar ou desafixar no topo"
                                                AutomationProperties.Name="Fixar ou desafixar nota">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="★" Foreground="{StaticResource NotesGoldBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Fixar"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource NotesButton}" Padding="12,6" Margin="0,0,6,0"
                                                Content="{Binding ArchiveActionText}"
                                                Command="{Binding ArchiveSelectedCommand}"
                                                IsEnabled="{Binding IsEditorEnabled}"
                                                AutomationProperties.Name="Arquivar ou desarquivar nota"/>
                                        <Button Style="{StaticResource NotesButton}" Padding="12,6"
                                                Content="Lixeira"
                                                Command="{Binding TrashSelectedCommand}"
                                                IsEnabled="{Binding IsEditorEnabled}"
                                                ToolTip="Mover para a lixeira"
                                                AutomationProperties.Name="Mover nota para a lixeira"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Trash banner -->
                                <Border Grid.Row="1" Background="#2D2428" BorderBrush="#5A3A41" BorderThickness="1"
                                        CornerRadius="11" Padding="14,9" Margin="0,0,0,10"
                                        Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Esta nota está na lixeira e não pode ser editada." Foreground="#FFD4D7"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource NotesButton}" Padding="12,5" Content="Restaurar"
                                                    Command="{Binding RestoreSelectedCommand}" Margin="10,0,6,0"
                                                    AutomationProperties.Name="Restaurar nota da lixeira"/>
                                            <Button Style="{StaticResource NotesButton}" Padding="12,5"
                                                    Content="Apagar para sempre" Click="OnDeletePermanentlyClick"
                                                    AutomationProperties.Name="Apagar nota permanentemente"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Title -->
                                <Grid Grid.Row="2" Margin="0,0,0,2">
                                    <TextBox x:Name="TitleBox" Style="{StaticResource PageTextBox}"
                                             FontSize="26" FontWeight="SemiBold" Padding="0,4"
                                             MaxLength="200"
                                             Text="{Binding TitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditorEnabled}"
                                             KeyDown="OnTitleKeyDown"
                                             AutomationProperties.Name="Título da nota"/>
                                    <TextBlock Text="Título" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{StaticResource NotesFaintBrush}"
                                               Margin="0,4,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Body -->
                                <ScrollViewer x:Name="BodyScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                                    <StackPanel Margin="0,4,10,10">
                                        <Grid>
                                            <TextBox x:Name="ContentBox" Style="{StaticResource PageTextBox}"
                                                     MinHeight="170" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                     FontSize="14.5" VerticalAlignment="Top"
                                                     Text="{Binding ContentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditorEnabled}"
                                                     AutomationProperties.Name="Conteúdo da nota"/>
                                            <TextBlock Text="Comece a escrever…" FontSize="14.5"
                                                       Foreground="{StaticResource NotesFaintBrush}"
                                                       VerticalAlignment="Top" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ContentBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Checklist -->
                                        <Border Background="#141921" BorderBrush="{StaticResource NotesBorderBrush}"
                                                BorderThickness="1" CornerRadius="13" Padding="14,12" Margin="0,18,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Checklist" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ChecklistProgress}"
                                                               Foreground="{StaticResource NotesAccentBrush}" FontSize="11.5"
                                                               Margin="10,1,0,0" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Style="{StaticResource NotesGhostButton}" Padding="9,4"
                                                            Click="OnAddChecklistItemClick"
                                                            IsEnabled="{Binding IsEditorEnabled}"
                                                            AutomationProperties.Name="Adicionar item ao checklist">
                                                        <TextBlock Text="＋ Item"/>
                                                    </Button>
                                                </Grid>
                                                <ItemsControl x:Name="ChecklistItems" ItemsSource="{Binding ChecklistDraft}"
                                                              AutomationProperties.Name="Itens do checklist">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Style="{StaticResource ChecklistCheckBox}"
                                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                          IsEnabled="{Binding DataContext.IsEditorEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                                                          AutomationProperties.Name="Concluir item"/>
                                                                <TextBox Grid.Column="1" Style="{StaticResource ChecklistTextBox}"
                                                                         Padding="0,6" FontSize="13.5"
                                                                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         IsEnabled="{Binding DataContext.IsEditorEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         KeyDown="OnChecklistItemKeyDown"
                                                                         AutomationProperties.Name="Texto do item"/>
                                                                <Button Grid.Column="2" Style="{StaticResource NotesGhostButton}"
                                                                        Padding="8,3" Margin="6,0,0,0"
                                                                        Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Remover item"
                                                                        AutomationProperties.Name="Remover item do checklist">
                                                                    <TextBlock Text="✕" FontSize="10.5"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tags -->
                                        <TextBlock Text="ETIQUETAS" Style="{StaticResource SectionLabel}" Margin="2,18,0,6"/>
                                        <Grid>
                                            <TextBox x:Name="TagsBox" Style="{StaticResource NotesTextBox}"
                                                     Text="{Binding TagsDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsEditorEnabled}"
                                                     AutomationProperties.Name="Etiquetas separadas por vírgula"
                                                     ToolTip="Separe as etiquetas com vírgulas"/>
                                            <TextBlock Text="trabalho, ideias, compras…" Foreground="{StaticResource NotesFaintBrush}"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TagsBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Footer -->
                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,1,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#69C98E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static vm:QuickNotesSaveState.Pending}">
                                                            <Setter Property="Fill" Value="#F5C451"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static vm:QuickNotesSaveState.Saving}">
                                                            <Setter Property="Fill" Value="#65B6FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static vm:QuickNotesSaveState.Error}">
                                                            <Setter Property="Fill" Value="#FF8B8B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SaveStateText}" Foreground="{StaticResource NotesMutedBrush}"
                                                   FontSize="11.5"/>
                                        <TextBlock Text="{Binding FooterInfo}" Foreground="{StaticResource NotesFaintBrush}"
                                                   FontSize="11.5" Margin="14,0,0,0"/>
                                        <TextBlock Text="{Binding SaveErrorMessage}" Foreground="{StaticResource NotesErrorBrush}"
                                                   FontSize="11.5" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource NotesButton}" Padding="12,5"
                                            Content="Tentar salvar de novo"
                                            Command="{Binding RetrySaveCommand}"
                                            Visibility="{Binding IsSaveError, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Tentar salvar de novo"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
