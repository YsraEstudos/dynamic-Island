<Window x:Class="Island.App.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island — Settings"
        Width="460"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#121212"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- Palette (local to this window) -->
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#121212"/>
        <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="SettingsRaisedBrush" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="SettingsTrackBrush" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="SettingsDividerBrush" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#8E8E93"/>
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="SettingsAccentSoftBrush" Color="#330A84FF"/>

        <!-- Text -->
        <Style x:Key="SettingsSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SettingsSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="SettingsRowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsRowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SettingsRowDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Containers -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,2,16,8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SettingsDividerBrush}"/>
        </Style>

        <!-- Slider: thin dark track, blue fill up to the thumb, white knob -->
        <ControlTemplate x:Key="SettingsThumbTemplate" TargetType="Thumb">
            <Ellipse Fill="#FFFFFF" Stretch="Fill"/>
        </ControlTemplate>

        <Style x:Key="SettingsTrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource SettingsAccentBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTrackGap" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource SettingsTrackBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource SettingsTrackFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource SettingsTrackGap}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16"
                                           Template="{StaticResource SettingsThumbTemplate}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch: pill with a knob that slides right when on -->
        <Style x:Key="SettingsSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchTrack"
                                CornerRadius="12"
                                Padding="3"
                                Background="{StaticResource SettingsTrackBrush}">
                            <Ellipse x:Name="SwitchKnob"
                                     Width="18" Height="18"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource SettingsAccentBrush}"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown: dark box with a chevron, dark popup list -->
        <Style x:Key="SettingsComboToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ComboBorder"
                                Background="{StaticResource SettingsRaisedBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Width="10" Height="6"
                                  Stretch="Fill"
                                  Fill="{StaticResource SettingsMutedBrush}"
                                  Data="M 0,0 L 5,5 L 10,0 Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="4,1"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SettingsTrackBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource SettingsComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{StaticResource SettingsSurfaceBrush}"
                                        BorderBrush="{StaticResource SettingsBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{StaticResource SettingsRaisedBrush}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SettingsTrackBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,12">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Changes apply immediately." Style="{StaticResource SettingsSubtitle}"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,12">

                <!-- Position -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="POSITION"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Display"/>
                            <ComboBox Grid.Column="1"
                                      Width="200"
                                      Style="{StaticResource SettingsComboBox}"
                                      ItemContainerStyle="{StaticResource SettingsComboItem}"
                                      ItemsSource="{Binding MonitorNames}"
                                      SelectedIndex="{Binding SelectedMonitorIndex, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <StackPanel Margin="0,10,0,10">
                            <Grid>
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Top margin"/>
                                <TextBlock Style="{StaticResource SettingsRowValue}"
                                           Text="{Binding TopMargin, StringFormat={}{0} px}"/>
                            </Grid>
                            <Slider Style="{StaticResource SettingsSlider}"
                                    Margin="0,8,0,0"
                                    Minimum="0" Maximum="80"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="10"
                                    Value="{Binding TopMargin, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Size -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="SIZE"/>

                        <StackPanel Margin="0,10,0,10">
                            <Grid>
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Compact width"/>
                                <TextBlock Style="{StaticResource SettingsRowValue}"
                                           Text="{Binding CompactWidth, StringFormat={}{0} px}"/>
                            </Grid>
                            <Slider Style="{StaticResource SettingsSlider}"
                                    Margin="0,8,0,0"
                                    Minimum="80" Maximum="240"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="10"
                                    Value="{Binding CompactWidth, Mode=TwoWay}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <StackPanel Margin="0,10,0,10">
                            <Grid>
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Compact height"/>
                                <TextBlock Style="{StaticResource SettingsRowValue}"
                                           Text="{Binding CompactHeight, StringFormat={}{0} px}"/>
                            </Grid>
                            <Slider Style="{StaticResource SettingsSlider}"
                                    Margin="0,8,0,0"
                                    Minimum="28" Maximum="60"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="5"
                                    Value="{Binding CompactHeight, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Timing -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="TIMING"/>

                        <StackPanel Margin="0,10,0,10">
                            <Grid>
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Volume display"/>
                                <TextBlock Style="{StaticResource SettingsRowValue}"
                                           Text="{Binding VolumeDisplaySeconds, StringFormat={}{0:0.0} s}"/>
                            </Grid>
                            <Slider Style="{StaticResource SettingsSlider}"
                                    Margin="0,8,0,0"
                                    Minimum="0.5" Maximum="6"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1" LargeChange="0.5"
                                    Value="{Binding VolumeDisplaySeconds, Mode=TwoWay}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <StackPanel Margin="0,10,0,10">
                            <Grid>
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Media preview"/>
                                <TextBlock Style="{StaticResource SettingsRowValue}"
                                           Text="{Binding MediaPreviewSeconds, StringFormat={}{0:0.0} s}"/>
                            </Grid>
                            <Slider Style="{StaticResource SettingsSlider}"
                                    Margin="0,8,0,0"
                                    Minimum="1" Maximum="10"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    SmallChange="0.1" LargeChange="1"
                                    Value="{Binding MediaPreviewSeconds, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="BEHAVIOR"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Hide in fullscreen"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Step aside while an app is fullscreen."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding HideInFullscreen, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Reduce animations"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Use simple fades instead of motion."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ReduceAnimations, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Start with Windows"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Launch Dynamic Island when you sign in."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Show volume"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Show the volume indicator when it changes."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowVolume, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Show media"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Show the track that is currently playing."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowMedia, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick notes -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="NOTAS RÁPIDAS"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Atalho global de captura"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Ctrl+Alt+N abre uma nota rápida de qualquer aplicativo."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Atalho global de captura de notas rápidas"
                                          AutomationProperties.HelpText="Ativa ou desativa Ctrl+Alt+N. A Estante continua disponível."
                                          IsChecked="{Binding QuickNotesHotkeyEnabled, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Idle capsule: weather or the start of a scheduled pomodoro, when nothing else is showing -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="CÁPSULA OCIOSA"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Clima e horário do pomodoro"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Com a ilha recolhida e sem música nem pomodoro, mostra a temperatura e a chance de chuva, ou o horário de um pomodoro agendado. Usa a internet."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Clima e horário do pomodoro na cápsula ociosa"
                                          IsChecked="{Binding IdleModeEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <StackPanel Margin="0,10,0,10">
                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Cidade do clima"/>
                            <TextBlock Style="{StaticResource SettingsRowDescription}"
                                       Text="Em branco, usa a localização aproximada pelo IP (uma consulta ao ipwho.is)."/>
                            <TextBox Margin="0,8,0,0"
                                     Padding="10,7"
                                     Background="{StaticResource SettingsRaisedBrush}"
                                     BorderBrush="{StaticResource SettingsBorderBrush}"
                                     Foreground="{StaticResource SettingsTextBrush}"
                                     CaretBrush="{StaticResource SettingsTextBrush}"
                                     AutomationProperties.Name="Cidade do clima"
                                     KeyDown="OnCommitOnEnter"
                                     Text="{Binding WeatherCity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Phone -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="PHONE"/>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Block phone during Angry"/>
                                <TextBlock Style="{StaticResource SettingsRowDescription}"
                                           Text="Angry also turns on the phone's scheduled block for the same time. Leaving Angry early does not free the phone."/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PhoneBlockEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsDivider}"/>

                        <StackPanel Margin="0,10,0,10">
                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="Phone token"/>
                            <TextBlock Style="{StaticResource SettingsRowDescription}"
                                       Text="In the Foco app on the phone: Bloqueio por horário → Copiar token do celular. Paste here."/>
                            <TextBox Margin="0,8,0,0"
                                     Padding="10,7"
                                     Background="{StaticResource SettingsRaisedBrush}"
                                     BorderBrush="{StaticResource SettingsBorderBrush}"
                                     Foreground="{StaticResource SettingsTextBrush}"
                                     CaretBrush="{StaticResource SettingsTextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="11.5"
                                     Text="{Binding PhoneFcmToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <Button x:Name="PhoneTestButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Content="Send 1-minute test block"
                                    IsEnabled="{Binding CanSendPhoneTest}"
                                    Click="OnSendPhoneTest"
                                    Style="{StaticResource SettingsButton}"/>
                            <TextBlock Style="{StaticResource SettingsRowDescription}"
                                       Text="{Binding PhoneStatus}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="UPDATES"/>

                        <StackPanel Margin="0,10,0,10">
                            <TextBlock Style="{StaticResource SettingsRowLabel}" Text="App updates"/>
                            <TextBlock Style="{StaticResource SettingsRowDescription}"
                                       Text="The app checks GitHub on its own every few hours. Check now to look right away."/>
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Content="Check for updates"
                                    IsEnabled="{Binding CanCheckForUpdates}"
                                    Click="OnCheckForUpdates"
                                    Style="{StaticResource SettingsButton}"/>
                            <TextBlock Style="{StaticResource SettingsRowDescription}"
                                       Text="{Binding UpdateStatus}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="24,12,24,16"
                BorderBrush="{StaticResource SettingsDividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Button HorizontalAlignment="Right"
                        Content="Reset to defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Style="{StaticResource SettingsButton}"/>
            </Grid>
        </Border>
    </Grid>
