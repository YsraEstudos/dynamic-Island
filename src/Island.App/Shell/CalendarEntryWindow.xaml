<Window x:Class="Island.App.Shell.CalendarEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo item do calendário"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource MenuBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource IslandFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="EntryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ShelfButtonBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Surface" Margin="24,22,24,20" Opacity="1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SurfaceTranslation" Y="0" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="KindTitle" Grid.Row="0" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="DateText" Grid.Row="1" Margin="0,5,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <TextBlock x:Name="NameLabel" Grid.Row="2" Margin="0,18,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Border Grid.Row="3" Margin="0,6,0,0" Padding="12,9"
                Background="{StaticResource ShelfTileBrush}"
                BorderBrush="{StaticResource MenuSeparatorBrush}" BorderThickness="1" CornerRadius="10">
            <TextBox x:Name="NameBox" Padding="0" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                     FontSize="15" MaxLength="100" SpellCheck.IsEnabled="False"
                     AutomationProperties.Name="Título ou nome" />
        </Border>
        <TextBlock x:Name="NameError" Grid.Row="4" Margin="0,5,0,0"
                   Text="Digite um nome para continuar." FontSize="11"
                   Foreground="{StaticResource MutedRedBrush}" Visibility="Collapsed" />

        <StackPanel x:Name="EventOptions" Grid.Row="5" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Horário (opcional)" Foreground="{StaticResource TextSecondaryBrush}" />
            <Border Margin="0,6,0,0" Padding="12,9" Width="124" HorizontalAlignment="Left"
                    Background="{StaticResource ShelfTileBrush}"
                    BorderBrush="{StaticResource MenuSeparatorBrush}" BorderThickness="1" CornerRadius="10">
                <TextBox x:Name="TimeBox" Padding="0" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource TextPrimaryBrush}"
                         FontSize="16" MaxLength="5" SpellCheck.IsEnabled="False"
                         AutomationProperties.Name="Horário opcional, no formato horas e minutos" />
            </Border>
            <TextBlock x:Name="TimeError" Margin="0,5,0,0"
                       Text="Use HH:mm, por exemplo 14:30. Deixe vazio para dia inteiro."
                       FontSize="11" Foreground="{StaticResource MutedRedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border x:Name="BirthdayInfo" Grid.Row="5" Margin="0,16,0,0" Padding="12,10"
                Background="{StaticResource ShelfTileBrush}" CornerRadius="10" Visibility="Collapsed">
            <TextBlock Text="Este aniversário se repete todos os anos. 29 de fevereiro aparece apenas em anos bissextos."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <TextBlock x:Name="SaveError" Grid.Row="6" Margin="0,14,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedRedBrush}" Visibility="Collapsed" />

        <Grid Grid.Row="7" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Style="{StaticResource EntryActionButtonStyle}"
                    Click="OnCancelClicked" />
            <Button x:Name="SaveButton" Grid.Column="3" Content="Salvar" IsDefault="True"
                    Background="{StaticResource AccentBlueBrush}"
                    Style="{StaticResource EntryActionButtonStyle}" Click="OnSaveClicked" />
        </Grid>
    </Grid>
</Window>
