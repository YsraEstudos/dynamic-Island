<Window x:Class="Island.App.Shell.PomodoroTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Width="960" Height="540"
        Topmost="True" ShowInTaskbar="False" Background="#0D1014"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.65" RadiusY="0.85">
                <GradientStop x:Name="Glow" Color="#252219" Offset="0"/>
                <GradientStop Color="#0D1014" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Button x:Name="CloseButton" Content="Fechar  ·  Esc" Click="OnCloseClicked"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="28"
                Padding="18,10" Foreground="#DDDDDD" Background="#20242B"
                BorderThickness="0" Cursor="Hand" FontSize="14"/>
        <Viewbox Margin="60,85,60,95" Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel x:Name="Surface" Width="820" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="Entrance"/>
                </StackPanel.RenderTransform>
                <TextBlock x:Name="Eyebrow" Text="PAUSA MERECIDA" Foreground="#B8A68A"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,26"/>
                <Grid Width="200" Height="155" Margin="0,0,0,24">
                    <Canvas x:Name="Coffee" Width="200" Height="155">
                        <Ellipse Width="148" Height="12" Canvas.Left="24" Canvas.Top="140" Fill="#24272B"/>
                        <Path x:Name="SteamOne" Data="M 76,60 C 53,40 94,28 75,5" Stroke="#C3A57C" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.65">
                            <Path.RenderTransform><TranslateTransform x:Name="SteamOneMove"/></Path.RenderTransform>
                        </Path>
                        <Path x:Name="SteamTwo" Data="M 102,53 C 82,34 122,24 101,0" Stroke="#C3A57C" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.45">
                            <Path.RenderTransform><TranslateTransform x:Name="SteamTwoMove"/></Path.RenderTransform>
                        </Path>
                        <Path x:Name="SteamThree" Data="M 127,60 C 108,42 144,31 126,12" Stroke="#C3A57C" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.55">
                            <Path.RenderTransform><TranslateTransform x:Name="SteamThreeMove"/></Path.RenderTransform>
                        </Path>
                        <Path Data="M 143,80 L 156,80 C 184,80 183,116 148,116" Stroke="#E8C79A" StrokeThickness="7"/>
                        <Path Data="M 48,73 L 148,73 L 141,116 Q 138,136 117,136 L 79,136 Q 58,136 55,116 Z" Fill="#E8C79A"/>
                        <Ellipse Canvas.Left="48" Canvas.Top="67" Width="100" Height="14" Fill="#FADEB7"/>
                        <Ellipse Canvas.Left="56" Canvas.Top="70" Width="84" Height="7" Fill="#604636"/>
                        <Path Data="M 43,142 L 155,142" Stroke="#A89072" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <Canvas x:Name="Study" Width="200" Height="155" Visibility="Collapsed">
                        <Ellipse Canvas.Left="36" Canvas.Top="10" Width="128" Height="128" Stroke="#512D34" StrokeThickness="2"/>
                        <Path Data="M 59,55 Q 79,48 100,62 Q 121,48 141,55 L 141,107 Q 121,100 100,114 Q 79,100 59,107 Z M 100,62 L 100,114"
                              Stroke="#FF777D" StrokeThickness="4" StrokeLineJoin="Round"/>
                        <Path Data="M 70,71 L 87,74 M 70,84 L 87,87 M 113,74 L 130,71 M 113,87 L 130,84"
                              Stroke="#C6898D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Grid>
                <Grid Height="90">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="Headline" FontFamily="Consolas" FontSize="62" FontWeight="Bold"
                                   Foreground="#FFF1DB" AutomationProperties.LiveSetting="Polite"/>
                        <Border x:Name="Caret" Width="3" Height="57" Background="#CBB18B" Margin="9,0,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Subtitle" Foreground="#9CA3AF" FontFamily="Segoe UI" FontSize="19"
                           TextAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock x:Name="SessionGoalText" Foreground="#E0C7AA" FontSize="23" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" MaxHeight="72" Margin="0,18,0,0" Visibility="Collapsed"/>
                <Button x:Name="StartNextButton" Content="Iniciar" Click="OnStartNext" Visibility="Collapsed"
                        HorizontalAlignment="Center" Background="#E9B36B" Foreground="#191715" Padding="30,12" Margin="0,20,0,0" FontSize="18"/>
            </StackPanel>
        </Viewbox>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34">
            <TextBlock x:Name="FooterHint" Text="Esc para fechar · o cronômetro continua na ilha" Foreground="#87909D"
                       FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <Border Width="180" Height="2" Background="#2C3037">
                <Border x:Name="Lifetime" Background="#B8A68A" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="LifetimeScale"/></Border.RenderTransform>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</Window>
