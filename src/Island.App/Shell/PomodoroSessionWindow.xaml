<Window x:Class="Island.App.Shell.PomodoroSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro · Sessão" Width="500" Height="710" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Background="#111215" Foreground="#F3F3F5" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9CA5"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F3F5"/><Setter Property="Background" Value="#1D1F24"/>
            <Setter Property="CaretBrush" Value="#FFBC67"/><Setter Property="BorderBrush" Value="#34363E"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#DFA75F"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EBEBEF"/><Setter Property="Background" Value="#292B32"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#615038"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3F3F5"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Item" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#39332B"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#44382A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F3F5"/><Setter Property="Background" Value="#1D1F24"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="#1D1F24" BorderBrush="#34363E" BorderThickness="1" CornerRadius="8">
                                <Path Data="M0,0 L5,5 L10,0" Stroke="#A7A7AF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Margin="11,9,34,9" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="#24262C" BorderBrush="#44464F" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="230"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Switch" Width="36" Height="22" CornerRadius="11" Background="#373A43">
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="#D4D6DD" HorizontalAlignment="Left" Margin="3"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Switch" Property="Background" Value="#E9B36B"/>
                        <Setter TargetName="Dot" Property="Fill" Value="#211D16"/>
                        <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="Opacity" Value="0.65"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Background="#454853"><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1"/>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Surface">
        <Grid.RenderTransform><TranslateTransform x:Name="Entrance"/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="28,22,28,12">
            <TextBlock Text="POMODORO" FontSize="10" Foreground="#D6A76A" FontWeight="SemiBold"/>
            <TextBlock Text="Seu próximo foco" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,5"/>
            <TextBlock Text="{Binding LockMessage}" TextWrapping="Wrap" Foreground="#9A9CA5" FontSize="12"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,28,14" IsEnabled="{Binding CanConfigure}">
                <TextBlock Text="NOME DA SESSÃO" Style="{StaticResource Caption}"/>
                <TextBox x:Name="GoalBox" MaxLength="160" Text="{Binding Goal, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="Nome da sessão" ToolTip="Exemplo: Revisar matemática"/>
                <TextBlock Text="Opcional · aparece ao lado do contador; passe o mouse para ler o nome completo" Foreground="#737780" FontSize="11" Margin="0,6,0,13"/>
                <TextBlock Text="PERFIL" Style="{StaticResource Caption}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutomationProperties.Name="Perfil do Pomodoro"/>
                    <Button Grid.Column="1" Content="Novo" Command="{Binding NewProfileCommand}" Margin="10,0,0,0"/>
                </Grid>
                <Border Height="1" Background="#2C2E35" Margin="0,14,0,15"/>
                <Grid><TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="1–120 MIN" FontSize="10" Foreground="#737780" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="ProfileNameBox" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,10,0,12" AutomationProperties.Name="Nome do perfil"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Foco" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="FocusMinutesBox" Text="{Binding FocusMinutes, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" FontSize="25" AutomationProperties.Name="Minutos de foco"/>
                        <ComboBox ItemsSource="{Binding Sounds}" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,8,0,0"
                                  SelectedValue="{Binding FocusSound, Mode=TwoWay}" AutomationProperties.Name="Som do foco no perfil"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Descanso" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="BreakMinutesBox" Text="{Binding BreakMinutes, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" FontSize="25" AutomationProperties.Name="Minutos de descanso"/>
                        <ComboBox ItemsSource="{Binding Sounds}" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,8,0,0"
                                  SelectedValue="{Binding BreakSound, Mode=TwoWay}" AutomationProperties.Name="Som do descanso no perfil"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="AutoAdvanceCheck" Foreground="#E5E5E9" Margin="0,18,0,5" Content="Começar a próxima etapa automaticamente"
                          IsChecked="{Binding AutoAdvance, Mode=TwoWay}"/>
                <TextBlock Text="{Binding AdvanceDescription}" Foreground="#9A9CA5" FontSize="11" Margin="46,0,0,12"/>
                <Grid><Button Content="Excluir" Command="{Binding DeleteProfileCommand}" HorizontalAlignment="Left" Background="Transparent" Foreground="#AE9292"/>
                    <Button x:Name="SaveProfileButton" Content="Salvar perfil" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Salvar aplica os tempos, sons e avanço do perfil." FontSize="10" Foreground="#737780" Margin="0,7,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="28,10,28,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#C5AB88" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="Pronto" Background="#E9B36B" Foreground="#191715" FontWeight="SemiBold" Padding="24,10" Click="OnDone"/>
        </Grid>
    </Grid>
</Window>
