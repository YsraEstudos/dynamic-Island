<Window x:Class="Island.App.Shell.WeeklyPomodoroScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rotina semanal do Pomodoro"
        Width="700"
        Height="690"
        MinHeight="560"
        MaxHeight="850"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{StaticResource MenuBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource IslandFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ShelfButtonBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_Root" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource ShelfTileBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MenuSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rotina semanal" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,5,0,0"
                   Text="Cada faixa inicia o modo escolhido no começo e para no horário final."
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="EnabledCheck" Grid.Column="0" VerticalAlignment="Center"
                      Content="Ativar rotina semanal" FontWeight="SemiBold"
                      Checked="OnEnabledChanged" Unchecked="OnEnabledChanged" />
            <Button x:Name="SkipTomorrowButton" Grid.Column="1" Content="Pular amanhã"
                    Style="{StaticResource ActionButtonStyle}" Click="OnSkipTomorrowClicked" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Nova faixa" FontSize="14" FontWeight="SemiBold" />
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Grid.Column="0" MaxLength="160" FontSize="14"
                         ToolTip="Nome que aparece ao lado do contador" AutomationProperties.Name="Nome da sessão" />
                <TextBox x:Name="StartBox" Grid.Column="2" Width="86" MaxLength="5" FontSize="15"
                         Text="09:00" HorizontalContentAlignment="Center" AutomationProperties.Name="Horário inicial" />
                <TextBox x:Name="EndBox" Grid.Column="4" Width="86" MaxLength="5" FontSize="15"
                         Text="10:00" HorizontalContentAlignment="Center" AutomationProperties.Name="Horário final" />
            </Grid>
            <TextBlock Grid.Row="2" Margin="0,11,0,4" Text="Dias da semana"
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <WrapPanel x:Name="DaysPanel" Grid.Row="3" />
            <Grid Grid.Row="4" Margin="0,12,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Modo" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox x:Name="ModeBox" Grid.Column="1" SelectedIndex="0" Padding="8,5"
                          AutomationProperties.Name="Modo do Pomodoro">
                    <ComboBoxItem Content="Focus" Tag="Focus" />
                    <ComboBoxItem Content="Angry" Tag="Angry" />
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Pomodoros" VerticalAlignment="Center" Margin="18,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button x:Name="MinusButton" Grid.Column="3" Content="−" Width="34" Padding="0,5"
                        Style="{StaticResource ActionButtonStyle}" Click="OnMinusClicked" />
                <TextBlock x:Name="CyclesText" Grid.Column="4" Text="1" Width="34" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                <Button x:Name="PlusButton" Grid.Column="5" Content="+" Width="34" Padding="0,5"
                        HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" Click="OnPlusClicked" />
            </Grid>

            <Grid Grid.Row="5">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#C5AB88"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" Content="Adicionar faixa" Background="{StaticResource AccentBlueBrush}"
                            Style="{StaticResource ActionButtonStyle}" Click="OnAddClicked" />
                </Grid>
                <TextBlock Grid.Row="1" Text="Faixas programadas" FontSize="14" FontWeight="SemiBold"
                           Margin="0,8,0,8" />
                <Grid Grid.Row="2">
                    <TextBlock x:Name="EmptyText" Text="Nenhuma faixa semanal cadastrada"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                    <ScrollViewer x:Name="BlocksScroll" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="240" Visibility="Collapsed">
                        <ItemsControl x:Name="BlocksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="10,8"
                                            Background="{StaticResource ShelfTileBrush}"
                                            BorderBrush="{StaticResource MenuSeparatorBrush}" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Day}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Range}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                            <TextBlock Grid.Column="2" Text="{Binding Mode}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{Binding ModeBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Cycles}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <Button Grid.Column="5" Width="28" Height="28" Margin="8,0,0,0" Padding="0"
                                                    Content="✕" ToolTip="Excluir faixa" Tag="{Binding Id}"
                                                    Foreground="{StaticResource MutedRedBrush}"
                                                    Style="{StaticResource ActionButtonStyle}" Click="OnDeleteClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Button Grid.Row="4" Margin="0,14,0,0" HorizontalAlignment="Right" Content="Fechar"
                IsCancel="True" Style="{StaticResource ActionButtonStyle}" Click="OnCloseClicked" />
    </Grid>
</Window>
