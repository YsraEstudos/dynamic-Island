<Window x:Class="Island.App.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Island.App.Views"
        Title="Dynamic Island"
        Width="1120"
        Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <!-- Root has no background: transparent pixels never catch the pointer. -->
    <Grid x:Name="RootGrid">
        <!-- The one shape that morphs between modes; it is anchored top-centre and grows downward. -->
        <Border x:Name="IslandShape"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="124"
                Height="36"
                CornerRadius="18"
                Background="{StaticResource IslandBlackBrush}">
            <Grid x:Name="ContentHost" ClipToBounds="True">
                <views:CompactView x:Name="CompactLayer" />
                <views:VolumeView x:Name="VolumeLayer" Visibility="Collapsed" />
                <!-- Docked (vertical) forms of the compact capsule and the volume bar. -->
                <views:VerticalCompactView x:Name="VerticalCompactLayer" Visibility="Collapsed" />
                <views:VerticalVolumeView x:Name="VerticalVolumeLayer" Visibility="Collapsed" />
                <views:MediaPreviewView x:Name="PreviewLayer" Visibility="Collapsed" />
                <views:NoticeView x:Name="NoticeLayer" Visibility="Collapsed" />
                <!-- One shelf layer serves Expanded and Customize; the swap hook switches its presentation. -->
                <views:ShelfView x:Name="ShelfLayer" Visibility="Collapsed" />
                <views:ClipboardView x:Name="ClipboardLayer" Visibility="Collapsed" />
                <!-- Mini pill: no content, the bare capsule. A click restores Compact. -->
                <Grid x:Name="MiniLayer" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
